---
import type { ImageMetadata } from "astro";
import datavilla from "../data/datavilla.json";

export const prerender = true;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="2" y="2" width="60" height="60" rx="16" fill="#0770cd"/><path d="M14 33 L32 16 L50 33" fill="none" stroke="#ff5e1f" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 31 V44 H43 V31" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 51 Q24 47 32 51 T48 51" fill="none" stroke="#7dd3fc" stroke-width="3.8" stroke-linecap="round"/></svg>`;
const faviconDataUri = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

interface Villa {
  id: string;
  name: string;
  location: string;
  price_per_night: number;
  kapasitas_maks: number;
  jumlah_kamar: number;
  rating: number;
  jumlah_ulasan: number;
  deskripsi_singkat?: string;
  deskripsi_panjang?: string;
  halaman_luas?: boolean;
  pet_friendly?: boolean;
  view_gunung?: boolean;
  desain_klasik?: boolean;
  private_pool?: boolean;
  karaoke?: boolean;
  meja_biliar?: boolean;
  mewah?: boolean;
  fasilitas?: string[];
  wisata_terdekat?: string[];
  restoran_terdekat?: string[];
  main_photo_url?: string;
  gallery_urls?: string[];
}

interface FaqItem {
  q: string;
  a: string;
}

interface GeneratedPage {
  slug: string;
  category: "Kapasitas" | "Kamar Tidur" | "Lokasi" | "Fasilitas" | "Harga" | "Kombinasi";
  keyword: string;
  title: string;
  metaDescription: string;
  heroSubtitle: string;
  articleTitle: string;
  articleParagraphs: string[];
  tipsList: string[];
  faqs: FaqItem[];
  villas: Villa[];
}

function randomRatingCount(min = 6500, max = 15000): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

export function getStaticPaths() {
  const allVillas = (Array.isArray(datavilla) ? datavilla : []) as Villa[];
  const pagesMap = new Map<string, GeneratedPage>();

  const toSlug = (t: string) =>
    (t || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const buildVillaDetailSlug = (v: Villa, index: number) => {
    const idClean = (v.id || "").trim().toLowerCase();
    const nameSlug = toSlug(v.name || "");

    if (idClean && nameSlug && toSlug(idClean).includes(nameSlug)) {
      return toSlug(idClean);
    }
    if (idClean && nameSlug) {
      return `${toSlug(idClean)}-${nameSlug}`;
    }
    if (idClean) {
      return toSlug(idClean);
    }
    if (nameSlug) {
      return nameSlug;
    }
    return `villa-${index + 1}`;
  };

  const usedVillaSlugs = new Set<string>();
  const villaSlugMap = new Map<string, string>();
  allVillas.forEach((v, idx) => {
    let baseSlug = buildVillaDetailSlug(v, idx);
    if (!baseSlug) baseSlug = `villa-${idx + 1}`;

    let finalSlug = baseSlug;
    let counter = 2;
    while (usedVillaSlugs.has(finalSlug)) {
      finalSlug = `${baseSlug}-${counter}`;
      counter++;
    }
    usedVillaSlugs.add(finalSlug);
    const key = v.id ? `${v.id}::${idx}` : `idx::${idx}`;
    villaSlugMap.set(key, finalSlug);
  });

  const fmtRp = (n: number) =>
    new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    }).format(n);

  const getPriceRangeText = (list: Villa[]) => {
    if (!list.length) return "terjangkau";
    const prices = list.map((v) => v.price_per_night || 0).filter((p) => p > 0);
    if (!prices.length) return "terjangkau";
    const minP = Math.min(...prices);
    const maxP = Math.max(...prices);
    return minP === maxP ? `mulai ${fmtRp(minP)}/malam` : `${fmtRp(minP)} – ${fmtRp(maxP)}/malam`;
  };

  const addPage = (page: GeneratedPage) => {
    if (page.villas.length === 0) return;
    if (!pagesMap.has(page.slug)) {
      pagesMap.set(page.slug, page);
    }
  };

  // 1. SEMUA VARIASI KAPASITAS TAMU
  const capacityBuckets = [10, 12, 15, 20, 25, 30, 35, 40, 50, 60, 80, 100];
  for (const cap of capacityBuckets) {
    const minCap = cap;
    const maxCap = cap <= 15 ? cap + 5 : cap <= 30 ? cap + 10 : cap + 25;
    const matched = allVillas.filter(
      (v) => (v.kapasitas_maks || 0) >= minCap && (v.kapasitas_maks || 0) <= maxCap
    );
    if (matched.length > 0) {
      const keyword = `Sewa Villa Kapasitas ${cap} Orang`;
      const priceText = getPriceRangeText(matched);
      addPage({
        slug: `sewa-villa-kapasitas-${cap}-orang`,
        category: "Kapasitas",
        keyword,
        title: `${keyword} di Puncak & Cipanas`,
        metaDescription: `Pilihan ${keyword.toLowerCase()} di Puncak, Cipanas, dan Kota Bunga (${matched.length} unit tersedia, harga ${priceText}). Cek foto, fasilitas & booking WA.`,
        heroSubtitle: `Tersedia ${matched.length} pilihan villa nyaman di kawasan Puncak & Cipanas untuk rombongan sekitar ${cap} orang dengan kisaran tarif ${priceText}.`,
        articleTitle: `Panduan Lengkap Memilih ${keyword} di Kawasan Puncak`,
        articleParagraphs: [
          `Merencanakan perjalanan bersama rombongan sekitar ${cap} orang membutuhkan pertimbangan yang jauh lebih matang dibanding liburan keluarga kecil. Selain jumlah kamar tidur, kenyamanan rombongan sangat ditentukan oleh proporsi ruang keluarga, area makan bersama, jumlah kamar mandi agar antrean pagi tidak menumpuk, serta ketersediaan lahan parkir untuk beberapa mobil atau kendaraan rombongan. Dengan memilih unit berkapasitas ${minCap} hingga ${maxCap} tamu, seluruh peserta memiliki ruang gerak yang cukup leluasa tanpa membuat suasana rumah terasa penuh sesak.`,
          `Di katalog villa.web.id, tersedia ${matched.length} unit yang sesuai untuk kategori ${keyword.toLowerCase()} dengan kisaran tarif ${priceText}, tersebar di kawasan strategis seperti Puncak, Cipanas, Kota Bunga, Cisarua, dan sekitarnya. Setiap unit memiliki karakter tata ruang yang berbeda—ada yang menonjolkan halaman luas untuk games dan kumpul sore, ada pula yang fokus pada fasilitas hiburan dalam ruangan seperti karaoke, meja biliar, atau private pool.`,
          `Agar anggaran dan pengalaman menginap tetap seimbang, perhatikan dinamika komposisi peserta sejak awal. Jika rombongan terdiri atas keluarga lintas generasi dengan lansia dan anak-anak, utamakan kamar di lantai dasar serta akses jalan masuk yang landai. Sebaliknya, jika tujuan utamanya adalah gathering komunitas, reuni, atau acara kantor sekitar ${cap} orang, pilih villa dengan ruang berkumpul terbuka, area BBQ, dan sirkulasi udara yang baik agar diskusi maupun aktivitas kebersamaan berjalan lancar.`,
        ],
        tipsList: [
          `Susun pembagian kamar tidur, tempat tidur utama, serta kebutuhan extra bed untuk ${cap} peserta jauh sebelum hari H agar tidak ada tamu yang kebagian ruang kurang nyaman.`,
          `Periksa lebar akses jalan dan kapasitas parkir kendaraan apabila rombongan datang memakai beberapa mobil pribadi, elf, atau bus kecil.`,
          `Cek fasilitas dapur, kulkas, dispenser, serta kelengkapan alat masak dan BBQ bila berencana menyiapkan konsumsi mandiri selama menginap.`,
          `Konfirmasi jadwal check-in, kebijakan ketertiban lingkungan pada malam hari, dan ketersediaan tanggal secara langsung kepada admin villa.web.id.`,
        ],
        faqs: [
          {
            q: `Berapa kisaran harga ${keyword.toLowerCase()} di Puncak?`,
            a: `Untuk kategori ${keyword.toLowerCase()}, tarif sewa berkisar ${priceText} tergantung hari menginap (weekday/weekend) dan fasilitas masing-masing villa.`,
          },
          {
            q: `Apakah villa kapasitas ${cap} orang boleh mengadakan acara kumpul atau BBQ?`,
            a: `Boleh, sebagian besar villa sudah dilengkapi ruang keluarga luas, teras/halaman, dan area BBQ selama tetap menjaga ketertiban lingkungan sekitar.`,
          },
          {
            q: `Bagaimana cara cek jadwal kosong untuk ${keyword.toLowerCase()}?`,
            a: `Klik tombol Lihat Detail pada unit yang Anda minati, lalu tekan Booking via WA untuk pengecekan tanggal secara real-time.`,
          },
        ],
        villas: matched,
      });
    }
  }

  // 2. SEMUA VARIASI JUMLAH KAMAR TIDUR
  const roomCounts = Array.from(
    new Set(allVillas.map((v) => v.jumlah_kamar).filter((k) => Number.isFinite(k) && k > 0))
  ).sort((a, b) => a - b);

  for (const rooms of roomCounts) {
    const matched = allVillas.filter((v) => v.jumlah_kamar === rooms);
    if (matched.length > 0) {
      const keyword = `Sewa Villa ${rooms} Kamar Tidur di Puncak`;
      const priceText = getPriceRangeText(matched);
      const minGuest = Math.min(...matched.map((v) => v.kapasitas_maks || 0));
      const maxGuest = Math.max(...matched.map((v) => v.kapasitas_maks || 0));
      addPage({
        slug: `sewa-villa-${rooms}-kamar-tidur-di-puncak`,
        category: "Kamar Tidur",
        keyword,
        title: `${keyword} — ${matched.length} Pilihan Unit `,
        metaDescription: `Daftar ${keyword.toLowerCase()} dengan kapasitas ${minGuest}–${maxGuest} tamu dan harga ${priceText}. Lihat galeri foto dan fasilitas lengkap.`,
        heroSubtitle: `Temukan ${matched.length} unit villa ${rooms} kamar tidur di Puncak & Cipanas untuk kapasitas ${minGuest} sampai ${maxGuest} tamu (${priceText}).`,
        articleTitle: `Keunggulan & Panduan Memilih ${keyword}`,
        articleParagraphs: [
          `Memilih ${keyword.toLowerCase()} memberikan struktur pembagian ruang istirahat yang lebih rapi dan privat bagi keluarga maupun rombongan. Dibandingkan menginap di hunian dengan kamar terbatas lalu mengandalkan area terbuka untuk tidur, jumlah kamar yang sesuai membantu menjaga kualitas tidur setiap tamu setelah seharian beraktivitas di udara sejuk Puncak.`,
          `Saat ini tersedia ${matched.length} unit villa dengan ${rooms} kamar tidur yang dapat dibandingkan melalui villa.web.id dengan kapasitas tampung mulai dari ${minGuest} hingga ${maxGuest} orang dan kisaran tarif ${priceText}. Perbedaan kapasitas dalam jumlah kamar yang sama biasanya dipengaruhi oleh ukuran kamar, jenis ranjang, penambahan extra bed, serta luas ruang komunal di dalam villa.`,
          `Selain jumlah kamar, perhatikan juga bagaimana alur aktivitas harian berlangsung di dalam unit. Jika sebagian besar waktu dihabiskan di dalam rumah, pertimbangkan villa yang memiliki ruang tamu terhubung ke teras atau taman serta fasilitas hiburan seperti karaoke, meja biliar, atau kolam renang pribadi. Jika agenda utama adalah menjelajah wisata dan kuliner sekitar, fokuslah pada lokasi strategis, akses parkir, dan kelengkapan fasilitas dasar seperti air panas dan dapur.`,
        ],
        tipsList: [
          `Bandingkan kapasitas maksimal tiap villa ${rooms} kamar karena ukuran bangunan, konfigurasi ranjang, dan jumlah kamar mandi antarunit bisa berbeda.`,
          `Pilih unit dengan fasilitas tambahan seperti private pool, karaoke, atau meja biliar bila ingin suasana menginap lebih variatif saat cuaca berkabut atau hujan.`,
          `Pastikan kebutuhan water heater dan perlengkapan dapur sudah sesuai dengan kebiasaan keluarga atau rombongan Anda.`,
          `Lakukan pemesanan lebih awal untuk jadwal akhir pekan, long weekend, dan musim liburan karena unit ${rooms} kamar tergolong cepat terisi.`,
        ],
        faqs: [
          {
            q: `Villa ${rooms} kamar tidur di Puncak muat untuk berapa orang?`,
            a: `Unit ${rooms} kamar tidur yang tersedia mampu menampung mulai dari ${minGuest} hingga ${maxGuest} tamu tergantung ukuran kamar dan ketersediaan tempat tidur.`,
          },
          {
            q: `Berapa harga sewa villa ${rooms} kamar tidur per malam?`,
            a: `Harga sewa untuk kategori ${rooms} kamar tidur berkisar ${priceText}.`,
          },
          {
            q: `Apakah fasilitas dapur dan water heater sudah tersedia?`,
            a: `Sebagian besar unit telah dilengkapi dapur lengkap beserta peralatan masak dan pemanas air (water heater). Anda bisa mengecek rinciannya pada halaman detail villa.`,
          },
        ],
        villas: matched,
      });
    }
  }

  // 3. SEMUA LOKASI UNIK DARI datavilla.json
  const uniqueLocations = Array.from(
    new Set(allVillas.map((v) => v.location?.trim()).filter(Boolean))
  ).sort((a, b) => a.localeCompare(b, "id"));

  for (const loc of uniqueLocations) {
    const matched = allVillas.filter(
      (v) => (v.location || "").trim().toLowerCase() === loc.toLowerCase()
    );
    if (matched.length > 0) {
      const locSlug = toSlug(loc);
      const keyword = `Sewa Villa ${loc}`;
      const priceText = getPriceRangeText(matched);
      addPage({
        slug: `sewa-villa-${locSlug}`,
        category: "Lokasi",
        keyword,
        title: `${keyword} — Pilihan Villa Terbaik & Harga Terbaru `,
        metaDescription: `Cari ${keyword.toLowerCase()}? Tersedia ${matched.length} villa pilihan di ${loc} dengan harga ${priceText}. Lengkap dengan foto, fasilitas & info wisata terdekat.`,
        heroSubtitle: `Katalog lengkap ${matched.length} villa pilihan di area ${loc} dengan suasana sejuk, akses strategis, dan tarif ${priceText}.`,
        articleTitle: `Rekomendasi & Panduan Lengkap ${keyword}`,
        articleParagraphs: [
          `Kawasan ${loc} merupakan salah satu pilihan populer bagi wisatawan yang menginginkan udara pegunungan yang segar sekaligus jarak tempuh yang masuk akal menuju berbagai titik wisata alam, taman rekreasi, dan pusat kuliner di kawasan Puncak–Cianjur. Karakter lingkungan di tiap area memiliki nuansa tersendiri—mulai dari kawasan kompleks tertata hingga area berbukit dengan panorama alam yang lebih terbuka.`,
          `Melalui villa.web.id, Anda dapat membandingkan ${matched.length} pilihan unit di ${loc} berdasarkan jumlah kamar tidur, kapasitas tamu, fasilitas unggulan, ulasan pengunjung, serta kisaran harga ${priceText}. Memilih lokasi yang selaras dengan rencana perjalanan akan membantu menghemat waktu tempuh dan mengurangi kelelahan di perjalanan.`,
          `Sebelum memutuskan unit mana yang paling pas, pertimbangkan pola perjalanan rombongan Anda. Bila ingin lebih banyak bersantai di dalam villa menikmati hawa dingin dan pemandangan, perhatikan fitur seperti halaman luas, balkon/teras, atau private pool. Bila agenda perjalanan banyak diisi wisata kuliner dan jalan-jalan sekitar, cek informasi wisata dan restoran terdekat pada halaman detail masing-masing villa di ${loc}.`,
        ],
        tipsList: [
          `Manfaatkan informasi wisata terdekat dan restoran terdekat di detail masing-masing villa area ${loc} untuk menyusun rute perjalanan yang efisien.`,
          `Atur waktu keberangkatan menuju ${loc} dengan memperhitungkan kepadatan arus lalu lintas akhir pekan maupun hari libur.`,
          `Perhatikan kondisi akses jalan dan fasilitas parkir unit di ${loc} sesuai jenis kendaraan yang digunakan.`,
          `Hubungi admin villa.web.id jika membutuhkan rekomendasi unit spesifik di ${loc} atau arahan menuju lokasi villa.`,
        ],
        faqs: [
          {
            q: `Ada berapa pilihan villa di ${loc}?`,
            a: `Saat ini tersedia ${matched.length} pilihan villa di kawasan ${loc} yang bisa langsung Anda lihat foto dan spesifikasinya di halaman ini.`,
          },
          {
            q: `Berapa tarif menginap di villa area ${loc}?`,
            a: `Tarif sewa villa di ${loc} berkisar ${priceText} per malam.`,
          },
          {
            q: `Apakah tersedia villa dengan kolam renang pribadi di ${loc}?`,
            a: `Ya, Anda bisa melihat label fasilitas unggulan pada setiap kartu villa atau membuka rincian fasilitas lewat halaman detail villa.`,
          },
        ],
        villas: matched,
      });
    }
  }

  // 4. SEMUA KATEGORI FASILITAS & FITUR UNGGULAN
  const featureConfigs: Array<{
    slug: string;
    keyword: string;
    heroSubtitle: string;
    articleTitle: string;
    articleParagraphs: string[];
    tipsList: string[];
    faqs: FaqItem[];
    filter: (v: Villa) => boolean;
  }> = [
    {
      slug: "sewa-villa-di-puncak-ada-kolam-renang",
      keyword: "Sewa Villa di Puncak Ada Kolam Renang",
      heroSubtitle:
        "Pilihan villa di Puncak, Cipanas, dan Kota Bunga yang dilengkapi kolam renang pribadi (private pool) untuk keluarga maupun rombongan.",
      articleTitle: "Panduan Lengkap Memilih Sewa Villa di Puncak Ada Kolam Renang",
      articleParagraphs: [
        "Villa dengan kolam renang pribadi (private pool) menjadi favorit banyak keluarga dan rombongan karena menawarkan privasi penuh tanpa harus berbagi area kolam dengan tamu lain. Anak-anak maupun anggota keluarga dapat berenang atau bermain air dengan lebih santai sesuai waktu luang masing-masing.",
        "Di kawasan berhawa sejuk seperti Puncak dan Cipanas, memilih villa berkolam renang pribadi juga menuntut ketelitian pada aspek keamanan dan kenyamanan. Kedalaman kolam, permukaan lantai sekitar kolam yang tidak licin, serta pengawasan orang dewasa sangat berpengaruh agar aktivitas air tetap aman bagi anak-anak.",
        "Selain itu, sesuaikan pilihan unit dengan kebutuhan menginap secara keseluruhan—apakah Anda juga membutuhkan halaman luas, ruang keluarga lega, fasilitas BBQ, atau hiburan tambahan seperti karaoke. Dengan membandingkan spesifikasi tiap unit di halaman ini, Anda bisa menemukan villa private pool yang paling sesuai dengan anggaran dan jumlah peserta.",
      ],
      tipsList: [
        "Perhatikan kedalaman kolam dan pastikan anak-anak selalu berada dalam pengawasan orang dewasa saat berada di dekat area air.",
        "Siapkan pakaian renang, handuk tambahan, serta jaket atau baju hangat karena udara pegunungan terasa cukup sejuk setelah berenang.",
        "Tanyakan informasi perawatan dan kondisi kolam sebelum hari kedatangan agar pengalaman menginap lebih maksimal.",
        "Lakukan reservasi lebih awal terutama pada akhir pekan dan musim liburan karena unit private pool memiliki peminat tinggi.",
      ],
      faqs: [
        {
          q: "Apakah kolam renangnya bersifat private pool?",
          a: "Ya, seluruh villa dalam daftar ini memiliki fasilitas kolam renang pribadi khusus untuk penyewa unit villa tersebut.",
        },
        {
          q: "Apakah tersedia villa kolam renang untuk rombongan besar?",
          a: "Tersedia berbagai pilihan kapasitas mulai dari keluarga kecil hingga rombongan puluhan orang.",
        },
      ],
      filter: (v) => Boolean(v.private_pool),
    },
    {
      slug: "sewa-villa-puncak-view-gunung",
      keyword: "Sewa Villa Puncak View Gunung",
      heroSubtitle:
        "Nikmati panorama perbukitan dan pegunungan langsung dari teras, balkon, maupun ruang santai villa Anda.",
      articleTitle: "Keunggulan & Panduan Memilih Sewa Villa Puncak View Gunung",
      articleParagraphs: [
        "Salah satu alasan utama wisatawan memilih berlibur ke kawasan Puncak adalah kesempatan menikmati lanskap perbukitan, lembah hijau, dan siluet pegunungan yang menenangkan. Menginap di villa dengan view gunung menghadirkan nuansa relaksasi yang terasa sejak pagi hari saat membuka tirai kamar atau menyeruput kopi hangat di teras.",
        "Kejelasan pemandangan alam di dataran tinggi sangat dipengaruhi oleh waktu hari dan kondisi cuaca. Pagi hari sering kali menyuguhkan udara paling jernih sebelum kabut atau awan turun menutupi lereng perbukitan pada siang hingga sore hari.",
        "Saat memilih villa view gunung, perhatikan juga tata letak area santai seperti balkon, teras, atau halaman menghadap pemandangan, serta kelengkapan fasilitas penghangat dan kenyamanan ruang seperti air panas (water heater) dan ruang keluarga yang nyaman untuk berkumpul.",
      ],
      tipsList: [
        "Luangkan waktu pada pagi hari (sekitar pukul 06.00–08.00 WIB) untuk menikmati panorama gunung dan udara segar sebelum kabut turun.",
        "Bawa pakaian hangat, kaus kaki, dan selimut tambahan bila Anda mudah merasa dingin saat duduk di balkon atau teras malam hari.",
        "Cek posisi kamar dan area kumpul pada foto galeri villa untuk memastikan sudut pandang sesuai ekspektasi.",
      ],
      faqs: [
        {
          q: "Apakah semua villa di halaman ini memiliki pemandangan gunung?",
          a: "Ya, daftar ini dikurasi khusus untuk unit villa yang memiliki keunggulan view gunung atau panorama alam terbuka.",
        },
        {
          q: "Bagaimana cara memesan villa view gunung ini?",
          a: "Pilih villa yang disukai, klik Lihat Detail, lalu hubungi admin via WhatsApp untuk konfirmasi tanggal.",
        },
      ],
      filter: (v) => Boolean(v.view_gunung),
    },
    {
      slug: "sewa-villa-puncak-halaman-luas",
      keyword: "Sewa Villa Puncak Halaman Luas",
      heroSubtitle:
        "Rekomendasi villa dengan halaman dan taman luas untuk kegiatan outdoor, fun games, anak-anak, maupun acara keluarga.",
      articleTitle: "Manfaat & Panduan Memilih Villa dengan Halaman Luas di Puncak",
      articleParagraphs: [
        "Villa dengan halaman atau taman yang luas memberikan keleluasaan ruang yang sulit ditemukan pada akomodasi standar. Bagi keluarga yang membawa anak-anak, area terbuka ini menjadi ruang bermain alami yang lebih bebas dan menyegarkan dibanding hanya beraktivitas di dalam ruangan.",
        "Untuk rombongan keluarga besar, komunitas, atau acara kumpul perusahaan, halaman luas juga mempermudah penyusunan berbagai kegiatan seperti senam pagi, fun games ringan, sesi foto bersama, maupun acara bakar-bakar (BBQ) saat sore menjelang malam.",
        "Ketika memilih villa berhalaman luas, sesuaikan luas area dengan jumlah peserta serta jenis kegiatan yang direncanakan. Pastikan pula Anda berkoordinasi mengenai aturan penggunaan area taman dan ketertiban lingkungan agar kenyamanan bersama tetap terjaga.",
      ],
      tipsList: [
        "Informasikan rencana kegiatan outdoor, games kelompok, atau pemasangan perlengkapan tambahan sejak awal agar sesuai dengan kapasitas area dan aturan villa.",
