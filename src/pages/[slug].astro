const ratingCountRandom = randomRatingCount(6500, 15000);

const relatedPages = allPages
  .filter((p) => p.slug !== page.slug)
  .sort((a, b) => {
    if (a.category === page.category && b.category !== page.category) return -1;
    if (a.category !== page.category && b.category === page.category) return 1;
    return b.count - a.count;
  })
  .slice(0, 14);

// --- LOGIKA MAPPING GAMBAR LOKAL ---
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/villas/**/*.{jpeg,jpg,png,webp}",
  { eager: true }
);

function getLocalAsset(cloudinaryUrl?: string): ImageMetadata | null {
  if (!cloudinaryUrl) return null;
  try {
    const parts = cloudinaryUrl.split(/\/v\d+\//);
    if (parts.length < 2) return null;
    const fileName = decodeURIComponent(parts[1]);
    const webpPath = fileName.replace(/\.[^/.]+$/, "") + ".webp";
    const localPath = `/src/assets/villas/${webpPath}`;
    const asset = localImages[localPath];
    return asset ? asset.default : null;
  } catch {
    return null;
  }
}

const fallbackImage = "https://placehold.co/800x500/e2e8f0/334155?text=Akang+Villa+Puncak";
const MAX_CARD_PHOTOS = 4;
const PAGE_SIZE = 10;

function formatRupiah(angka: number): string {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(angka);
}

function getRatingLabel(rating: number): string {
  if (rating >= 4.8) return "Mengesankan";
  if (rating >= 4.5) return "Sangat bagus";
  if (rating >= 4.0) return "Bagus";
  return "Nyaman";
}

function resolveSingleUrl(rawUrl?: string): string {
  if (!rawUrl || !rawUrl.trim()) return fallbackImage;
  const trimmed = rawUrl.trim();
  const localAsset = getLocalAsset(trimmed);
  if (localAsset) return localAsset.src;
  if (trimmed.startsWith("public/")) {
    return "/" + trimmed.slice("public/".length);
  }
  return trimmed;
}

function resolveAllGalleryUrls(villa: Villa): string[] {
  const combined = [villa.main_photo_url, ...(villa.gallery_urls || [])].filter(
    (u): u is string => Boolean(u && u.trim())
  );
  const uniqueRaw = Array.from(new Set(combined)).slice(0, MAX_CARD_PHOTOS);
  const resolved = uniqueRaw.map((u) => resolveSingleUrl(u));
  return resolved.length > 0 ? resolved : [fallbackImage];
}

function resolveVillaGallery(villa: Villa): {
  mainSrc: string;
  photos: string[];
} {
  const allPhotos = resolveAllGalleryUrls(villa);
  return {
    mainSrc: allPhotos[0],
    photos: allPhotos,
  };
}

function normalizeFacilities(rawFasilitas?: string[]): string[] {
  if (!Array.isArray(rawFasilitas) || rawFasilitas.length === 0) return [];
  const knownItems = [
    "Private Pool",
    "Kolam Renang Pribadi",
    "WiFi Gratis",
    "Free WiFi",
    "Area Parkir",
    "BBQ",
    "Area BBQ",
    "Area Taman/Halaman",
    "Halaman Luas",
    "AC",
    "Water Heater (Pemanas Air)",
    "Water Heater",
    "Dapur Lengkap",
    "Kulkas",
    "Dispenser Air",
    "Peralatan Masak",
    "Peralatan Makan",
    "TV Layar Datar",
    "Karaoke",
    "Meja Biliar",
    "Biliar",
    "Set Kursi & Meja Makan",
    "Sofa Ruang Tamu",
  ];

  const items: string[] = [];
  for (const entry of rawFasilitas) {
    if (!entry) continue;
    const text = entry.trim();
    if (text.length > 48) {
      let matchedAny = false;
      for (const known of knownItems) {
        if (text.toLowerCase().includes(known.toLowerCase()) && !items.includes(known)) {
          items.push(known);
          matchedAny = true;
        }
      }
      if (!matchedAny) items.push(text);
    } else if (!items.includes(text)) {
      items.push(text);
    }
  }
  return items;
}

function getHighlights(villa: Villa): string[] {
  const tags: string[] = [];
  if (villa.private_pool) tags.push("Private Pool");
  if (villa.view_gunung) tags.push("View Gunung");
  if (villa.halaman_luas) tags.push("Halaman Luas");
  if (villa.karaoke) tags.push("Karaoke");
  if (villa.meja_biliar) tags.push("Biliar");
  if (villa.pet_friendly) tags.push("Pet Friendly");
  if (villa.mewah) tags.push("Mewah");
  if (villa.desain_klasik) tags.push("Desain Klasik");
  if (tags.length === 0) {
    return normalizeFacilities(villa.fasilitas).slice(0, 3);
  }
  return tags.slice(0, 3);
}

const siteOrigin = "https://villa.web.id";
const canonicalUrl = `${siteOrigin}/${page.slug}`;

const validPrices = displayVillas
  .map((v) => v.price_per_night)
  .filter((p) => Number.isFinite(p) && p > 0);
const lowPrice = validPrices.length > 0 ? Math.min(...validPrices) : 850000;
const highPrice = validPrices.length > 0 ? Math.max(...validPrices) : 5000000;
const firstVillaPhotoRaw =
  displayVillas[0] ? resolveVillaGallery(displayVillas[0]).mainSrc : fallbackImage;
const firstVillaPhoto =
  firstVillaPhotoRaw && !firstVillaPhotoRaw.startsWith("https://placehold.co")
    ? new URL(firstVillaPhotoRaw, siteOrigin).toString()
    : `${siteOrigin}/og-image.jpg`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${page.keyword} — villa.web.id`,
  image: firstVillaPhoto,
  description: page.metaDescription,
  brand: {
    "@type": "Brand",
    name: "villa.web.id",
  },
  offers: {
    "@type": "AggregateOffer",
    url: canonicalUrl,
    priceCurrency: "IDR",
    lowPrice: lowPrice,
    highPrice: highPrice,
    offerCount: displayVillas.length,
    priceValidUntil: "2027-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: 4.9,
    bestRating: 5,
    worstRating: 1,
    ratingCount: ratingCountRandom,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
