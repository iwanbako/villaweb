              stroke-width="4.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M16 51 Q24 47 32 51 T48 51"
              fill="none"
              stroke="#7dd3fc"
              stroke-width="3.8"
              stroke-linecap="round"
            />
          </svg>
          <span class="brand-text">villa<span>.web.id</span></span>
        </a>
        <div class="topbar-right">
          <nav id="topbar-nav" class="topbar-nav" aria-label="Navigasi utama">
            <a href="/">Semua Villa</a>
            <a href="/cara-pesan">Cara Pesan</a>
            <a href="/bantuan">Bantuan</a>
            <a href="/kontak">Kontak</a>
            <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
          </nav>
          <span class="topbar-badge">Sewa Villa Puncak, Cipanas &amp; Kota Bunga</span>
          <button
            type="button"
            id="menu-toggle-btn"
            class="menu-toggle-btn"
            aria-label="Buka menu navigasi"
            aria-expanded="false"
            aria-controls="topbar-nav"
          >
            &#9776;
          </button>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span>/</span>
          <span>{page.category}</span>
          <span>/</span>
          <span>{page.keyword}</span>
        </nav>
        <h1>{page.keyword}</h1>
        <p>{page.heroSubtitle}</p>
      </div>
    </section>

    <div class="topic-nav-wrap">
      <nav class="topic-nav" aria-label="Pencarian populer">
        {
          relatedPages.slice(0, 8).map((item) => (
            <a href={`/${item.slug}`} class="topic-pill">
              {item.keyword} ({item.count})
            </a>
          ))
        }
      </nav>
    </div>

    <main class="container">
      <div class="result-bar">
        <div>
          Menampilkan <strong id="range-info">0</strong> dari{" "}
          <strong id="visible-count">{displayVillas.length}</strong> villa untuk{" "}
          <strong>{page.keyword}</strong>
        </div>
        <div class="sort-wrap">
          <label for="sort-select">Urutkan:</label>
          <select id="sort-select">
            <option value="default">Rekomendasi</option>
            <option value="price-asc">Harga Terendah</option>
            <option value="price-desc">Harga Tertinggi</option>
            <option value="rating-desc">Rating Tertinggi</option>
          </select>
        </div>
      </div>

      <section id="villa-list" class="list">
        {
          displayVillas.map((villa, idx) => {
            const { mainSrc, photos } = resolveVillaGallery(villa);
            const highlights = getHighlights(villa);
            const desc = villa.deskripsi_singkat || villa.deskripsi_panjang || "";
            const detailUrl = `/villa/${getVillaDetailSlug(villa)}`;

            return (
              <article
                class="villa-card"
                data-index={idx}
                data-price={villa.price_per_night || 0}
                data-rating={villa.rating || 0}
              >
                <div class="villa-media-col">
                  <div class="main-photo-box">
                    <img
                      class="main-photo"
                      src={mainSrc}
                      width={280}
                      height={184}
                      alt={`${villa.name} - ${page.keyword}`}
                      loading="eager"
                      decoding="async"
                      onerror={`this.onerror=null;this.src='${fallbackImage}';`}
                    />
                    {
                      photos.length > 1 && (
                        <>
                          <button
                            type="button"
                            class="photo-arrow-btn prev"
                            aria-label={`Foto sebelumnya ${villa.name}`}
                          >
                            &#8249;
                          </button>
                          <button
                            type="button"
                            class="photo-arrow-btn next"
                            aria-label={`Foto berikutnya ${villa.name}`}
                          >
                            &#8250;
                          </button>
                        </>
                      )
                    }
                    <span class="photo-count-pill">1 / {photos.length}</span>
                  </div>

                  {photos.length > 0 && (
                    <div class="gallery-strip" aria-label={`Galeri foto ${villa.name}`}>
                      {photos.map((photoSrc, tIdx) => (
                        <button
                          type="button"
                          class:list={["thumb-btn", tIdx === 0 && "active"]}
                          data-src={photoSrc}
                          data-photo-index={tIdx}
                          aria-label={`Lihat foto ${tIdx + 1} ${villa.name}`}
                        >
                          <img
                            src={photoSrc}
                            width={60}
                            height={40}
                            alt=""
                            loading="eager"
                            decoding="async"
                            onerror={`this.onerror=null;this.src='${fallbackImage}';`}
                          />
                        </button>
                      ))}
                    </div>
                  )}
                </div>

                <div class="villa-info">
                  <div class="villa-top">
                    <div style="min-width: 0;">
                      <h2 class="villa-title">
                        <a href={detailUrl}>{villa.name}</a>
                      </h2>
                      <div class="villa-loc">{villa.location}</div>
                    </div>
                    <div class="rating-box">
                      <div class="rating-text">
                        <span class="rating-label">{getRatingLabel(villa.rating)}</span>
                        <span class="rating-sub">{villa.jumlah_ulasan} ulasan</span>
                      </div>
                      <span class="rating-badge">{villa.rating.toFixed(1)}</span>
                    </div>
                  </div>

                  <div class="villa-specs">
                    {villa.jumlah_kamar} Kamar Tidur • Maksimal {villa.kapasitas_maks} Tamu
                  </div>

                  {desc && <p class="villa-desc">{desc}</p>}

                  {highlights.length > 0 && (
                    <div class="villa-tags">
                      {highlights.map((item) => (
                        <span class="tag">{item}</span>
                      ))}
                    </div>
                  )}
                </div>

                <div class="villa-price-col">
                  <div>
                    <span class="price-note">Harga mulai / malam</span>
                    <div class="price-val">{formatRupiah(villa.price_per_night)}</div>
                  </div>
                  <a href={detailUrl} class="cta-btn">
                    Lihat Detail
                  </a>
                </div>
              </article>
            );
          })
        }
      </section>

      <nav id="pagination" class="pagination" aria-label="Paginasi daftar villa"></nav>

      <!-- Artikel SEO -->
      <article class="content-card">
        <h2>{page.articleTitle}</h2>
        {page.articleParagraphs.map((p) => <p>{p}</p>)}
        <h3 class="modal-section-title" style="margin:0 0 8px;font-size:0.95rem;font-weight:700;">
          Tips Sebelum Memesan
        </h3>
        <ul class="tips-list">
          {page.tipsList.map((tip) => <li>{tip}</li>)}
        </ul>
      </article>

      <!-- FAQ -->
      <section class="content-card" aria-label="Pertanyaan yang Sering Diajukan (FAQ)">
        <h2>Pertanyaan Umum (FAQ) — {page.keyword}</h2>
        <div class="faq-list">
          {
            page.faqs.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.q}</span>
                  <span>+</span>
                </summary>
                <div class="faq-answer">{item.a}</div>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Internal Link pSEO Terkait -->
      <section class="content-card" aria-label="Pencarian Villa Terkait">
        <h2>Pencarian Villa Populer Lainnya</h2>
        <div class="related-grid">
          {
            relatedPages.map((rel) => (
              <a href={`/${rel.slug}`} class="related-link">
                {rel.keyword} ({rel.count})
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">
            <svg
              class="footer-logo"
              viewBox="0 0 64 64"
              width="28"
              height="28"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="60" height="60" rx="16" fill="#0194f3" />
              <path
                d="M14 33 L32 16 L50 33"
                fill="none"
                stroke="#ff5e1f"
                stroke-width="5.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M21 31 V44 H43 V31"
                fill="none"
                stroke="#ffffff"
                stroke-width="4.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16 51 Q24 47 32 51 T48 51"
                fill="none"
                stroke="#e0f2fe"
                stroke-width="3.8"
                stroke-linecap="round"
              />
            </svg>
            <span>villa<span>.web.id</span></span>
          </div>
          <p class="footer-copy">
            Layanan sewa villa di kawasan Puncak, Cipanas, Cisarua, dan Kota Bunga dengan proses booking jelas dan transparan.
          </p>
        </div>
        <nav class="footer-links" aria-label="Tautan informasi">
          <a href="/cara-pesan">Cara Pesan</a>
          <a href="/bantuan">Bantuan</a>
          <a href="/kontak">Kontak</a>
          <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>villa.web.id</span>
        <span>Puncak &bull; Cipanas &bull; Cisarua &bull; Kota Bunga</span>
      </div>
    </footer>

    <script is:inline define:vars={{ PAGE_SIZE, fallbackImage }}>
      function initPseoPage() {
        const menuToggleBtn = document.getElementById("menu-toggle-btn");
        const topbarNav = document.getElementById("topbar-nav");
        const topbarEl = document.getElementById("topbar");

        function setMobileMenuOpen(isOpen) {
          if (!topbarNav || !menuToggleBtn) return;
          topbarNav.classList.toggle("is-open", isOpen);
          menuToggleBtn.setAttribute("aria-expanded", String(isOpen));
          menuToggleBtn.innerHTML = isOpen ? "&times;" : "&#9776;";
          menuToggleBtn.setAttribute(
            "aria-label",
            isOpen ? "Tutup menu navigasi" : "Buka menu navigasi"
          );
        }

        menuToggleBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = topbarNav?.classList.contains("is-open") || false;
          setMobileMenuOpen(!isOpen);
        });

        topbarNav?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMobileMenuOpen(false));
        });

        document.addEventListener("click", (e) => {
          if (!topbarNav?.classList.contains("is-open")) return;
          const target = e.target;
          if (target instanceof Node && !topbarNav.contains(target) && target !== menuToggleBtn) {
            setMobileMenuOpen(false);
          }
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setMobileMenuOpen(false);
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 640) setMobileMenuOpen(false);
        });

        function handleStickyHeader() {
          if (!topbarEl) return;
          topbarEl.classList.toggle("is-stuck", window.scrollY > 4);
        }

        window.addEventListener("scroll", handleStickyHeader, { passive: true });
        handleStickyHeader();

        const sortSelect = document.getElementById("sort-select");
        const listEl = document.getElementById("villa-list");
        const cards = Array.from(document.querySelectorAll(".villa-card"));
        const rangeInfoEl = document.getElementById("range-info");
        const visibleCountEl = document.getElementById("visible-count");
        const paginationEl = document.getElementById("pagination");

        // --- SLIDER FOTO UTAMA & THUMBNAIL USAP (POINTER EVENTS - DESKTOP & MOBILE) ---
        cards.forEach((card) => {
          const mainBox = card.querySelector(".main-photo-box");
          const mainImg = card.querySelector(".main-photo");
          const prevBtn = card.querySelector(".photo-arrow-btn.prev");
          const nextBtn = card.querySelector(".photo-arrow-btn.next");
          const counterPill = card.querySelector(".photo-count-pill");
          const stripEl = card.querySelector(".gallery-strip");
          const thumbs = Array.from(card.querySelectorAll(".thumb-btn"));

          const photoUrls = thumbs
            .map((btn) => btn.getAttribute("data-src") || "")
            .filter(Boolean);
          const list =
            photoUrls.length > 0
              ? photoUrls
              : [mainImg instanceof HTMLImageElement ? mainImg.src : fallbackImage];

          let currentIdx = 0;

          function setCardPhoto(idx, scrollThumbIntoView = false) {
            const total = list.length;
            currentIdx = ((idx % total) + total) % total;
            const src = list[currentIdx] || fallbackImage;

            if (mainImg instanceof HTMLImageElement) {
              mainImg.style.transform = "";
              mainImg.style.opacity = "0.72";
              mainImg.onerror = () => {
                mainImg.onerror = null;
                mainImg.src = fallbackImage;
              };
              mainImg.src = src;
              requestAnimationFrame(() => {
                mainImg.style.opacity = "1";
              });
            }

            if (counterPill) {
              counterPill.textContent = `${currentIdx + 1} / ${total}`;
            }

            thumbs.forEach((btn, i) => {
              const isActive = i === currentIdx;
              btn.classList.toggle("active", isActive);
              if (isActive && scrollThumbIntoView && stripEl instanceof HTMLElement) {
                const targetScroll =
                  btn.offsetLeft - stripEl.offsetLeft - (stripEl.clientWidth - btn.offsetWidth) / 2;
                stripEl.scrollTo({
                  left: Math.max(0, targetScroll),
                  behavior: "smooth",
                });
              }
            });
          }

          prevBtn?.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            setCardPhoto(currentIdx - 1, true);
          });

          nextBtn?.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            setCardPhoto(currentIdx + 1, true);
          });

          let activePointerId = null;
          let startX = 0;
          let startY = 0;
          let isHorizontalSwipe = false;

          mainBox?.addEventListener("pointerdown", (e) => {
            if (list.length <= 1) return;
            if (e.pointerType === "mouse" && e.button !== 0) return;
            if (e.target instanceof Element && e.target.closest(".photo-arrow-btn")) return;

            activePointerId = e.pointerId;
            startX = e.clientX;
            startY = e.clientY;
            isHorizontalSwipe = false;
            mainBox.classList.add("is-dragging");

            try {
              mainBox.setPointerCapture(e.pointerId);
            } catch {
              // Abaikan jika browser tidak mendukung setPointerCapture pada elemen ini
            }
          });

          mainBox?.addEventListener("pointermove", (e) => {
            if (activePointerId === null || e.pointerId !== activePointerId) return;

            const dx = e.clientX - startX;
            const dy = e.clientY - startY;

            if (!isHorizontalSwipe && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
              isHorizontalSwipe = true;
            }

            if (isHorizontalSwipe && mainImg instanceof HTMLImageElement) {
              if (e.cancelable) e.preventDefault();
              const clamped = Math.max(-48, Math.min(48, dx * 0.35));
              mainImg.style.transition = "none";
              mainImg.style.transform = `translateX(${clamped}px)`;
            }
          });

          function finishPhotoPointer(e) {
            if (activePointerId === null || e.pointerId !== activePointerId) return;

            const dx = e.clientX - startX;
            const dy = e.clientY - startY;

            if (mainImg instanceof HTMLImageElement) {
              mainImg.style.transition = "transform 0.18s ease, opacity 0.18s ease";
              mainImg.style.transform = "";
            }

            if (isHorizontalSwipe && Math.abs(dx) > 22 && Math.abs(dx) >= Math.abs(dy) * 0.85) {
              if (dx < 0) {
                setCardPhoto(currentIdx + 1, true);
              } else {
                setCardPhoto(currentIdx - 1, true);
              }
            }

            activePointerId = null;
            isHorizontalSwipe = false;
            mainBox?.classList.remove("is-dragging");
          }

          mainBox?.addEventListener("pointerup", finishPhotoPointer);
          mainBox?.addEventListener("pointercancel", finishPhotoPointer);

          thumbs.forEach((btn, i) => {
            btn.addEventListener("click", (e) => {
              e.preventDefault();
              e.stopPropagation();
              setCardPhoto(i, true);
            });
          });
        });

        // --- PAGINASI & SORTING ---
        let currentPage = 1;

        function getCompactPages(current, total) {
          if (total <= 5) {
            return Array.from({ length: total }, (_, i) => i + 1);
          }
          const pages = [1];
          const start = Math.max(2, current - 1);
          const end = Math.min(total - 1, current + 1);
          if (start > 2) pages.push("...");
          for (let p = start; p <= end; p++) pages.push(p);
          if (end < total - 1) pages.push("...");
          pages.push(total);
          return pages;
        }

        function renderPagination(totalItems, totalPages) {
          if (!paginationEl) return;
          paginationEl.innerHTML = "";
          if (totalItems === 0 || totalPages <= 1) return;

          const prevBtn = document.createElement("button");
          prevBtn.type = "button";
          prevBtn.className = "page-btn";
          prevBtn.textContent = "‹ Prev";
          prevBtn.disabled = currentPage <= 1;
          prevBtn.addEventListener("click", () => {
            currentPage = Math.max(1, currentPage - 1);
            updateView(true);
          });
          paginationEl.appendChild(prevBtn);

          const compactPages = getCompactPages(currentPage, totalPages);
          for (const item of compactPages) {
            if (item === "...") {
              const span = document.createElement("span");
              span.className = "page-ellipsis";
              span.textContent = "…";
              paginationEl.appendChild(span);
              continue;
            }
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "page-btn" + (item === currentPage ? " active" : "");
            btn.textContent = String(item);
            btn.addEventListener("click", () => {
              currentPage = item;
              updateView(true);
            });
            paginationEl.appendChild(btn);
          }

          const nextBtn = document.createElement("button");
          nextBtn.type = "button";
          nextBtn.className = "page-btn";
          nextBtn.textContent = "Next ›";
          nextBtn.disabled = currentPage >= totalPages;
          nextBtn.addEventListener("click", () => {
            currentPage = Math.min(totalPages, currentPage + 1);
            updateView(true);
          });
          paginationEl.appendChild(nextBtn);
        }

        function updateView(shouldScroll = false) {
          if (!listEl) return;
          const sortBy = sortSelect instanceof HTMLSelectElement ? sortSelect.value : "default";
          const sorted = [...cards].sort((a, b) => {
            if (sortBy === "price-asc") return Number(a.dataset.price) - Number(b.dataset.price);
            if (sortBy === "price-desc") return Number(b.dataset.price) - Number(a.dataset.price);
            if (sortBy === "rating-desc") return Number(b.dataset.rating) - Number(a.dataset.rating);
            return Number(a.dataset.index) - Number(b.dataset.index);
          });

          const totalItems = sorted.length;
          const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
          if (currentPage > totalPages) currentPage = totalPages;

          const startIdx = (currentPage - 1) * PAGE_SIZE;
          const endIdx = startIdx + PAGE_SIZE;
          const pageSlice = new Set(sorted.slice(startIdx, endIdx));

          for (const card of sorted) {
            listEl.appendChild(card);
            if (card instanceof HTMLElement) {
              card.style.display = pageSlice.has(card) ? "" : "none";
            }
          }

          if (visibleCountEl) visibleCountEl.textContent = String(totalItems);
          if (rangeInfoEl) {
            rangeInfoEl.textContent =
              totalItems === 0 ? "0" : `${startIdx + 1}–${Math.min(endIdx, totalItems)}`;
          }

          renderPagination(totalItems, totalPages);

          if (shouldScroll) {
            const target = document.querySelector(".result-bar");
            if (target) {
              const top = target.getBoundingClientRect().top + window.scrollY - 72;
              window.scrollTo({ top: Math.max(0, top), behavior: "auto" });
            }
          }
        }

        sortSelect?.addEventListener("change", () => {
          currentPage = 1;
          updateView(false);
        });

        updateView(false);
      }

      initPseoPage();
      document.addEventListener("astro:after-swap", initPseoPage);
    </script>
  </body>
</html>