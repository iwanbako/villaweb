interface NavPageSummary {
  slug: string;
  keyword: string;
  category: GeneratedPage["category"];
  count: number;
}

interface Props {
  page: GeneratedPage;
  villaSlugMap: Record<string, string>;
  allPages: NavPageSummary[];
}

const { page, villaSlugMap, allPages } = Astro.props;
const allSourceVillas = (Array.isArray(datavilla) ? datavilla : []) as Villa[];

function getVillaDetailSlug(v: Villa): string {
  const idx = allSourceVillas.indexOf(v);
  const key = v.id ? `${v.id}::${idx}` : `idx::${idx}`;
  if (villaSlugMap[key]) return villaSlugMap[key];
  const raw = (v.id || v.name || `villa-${idx + 1}`)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
  return raw || `villa-${idx + 1}`;
}

