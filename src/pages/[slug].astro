        background: var(--tvk-sky);
        border-color: var(--tvk-sky);
        color: #fff;
      }

      .page-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .page-ellipsis {
        padding: 0 4px;
        color: var(--muted);
        font-weight: 700;
      }

      /* Artikel, FAQ & Internal Links */
      .content-card {
        margin-top: 26px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px 24px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: clip;
      }

      .content-card h2 {
        margin: 0 0 12px;
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--tvk-navy);
        overflow-wrap: anywhere;
      }

      .content-card p {
        margin: 0 0 12px;
        font-size: 0.94rem;
        line-height: 1.65;
        color: #334155;
        overflow-wrap: anywhere;
      }

      .tips-list {
        margin: 8px 0 0;
        padding-left: 20px;
        font-size: 0.92rem;
        line-height: 1.6;
        color: #334155;
        overflow-wrap: anywhere;
      }

      .faq-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .faq-item {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        background: #f8fafc;
        max-width: 100%;
      }

      .faq-item summary {
        list-style: none;
        padding: 13px 16px;
        font-weight: 700;
        font-size: 0.94rem;
        color: var(--text);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        overflow-wrap: anywhere;
      }

      .faq-item summary > span:first-child {
        min-width: 0;
        flex: 1 1 auto;
      }

      .faq-item summary > span:last-child {
        flex-shrink: 0;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item[open] summary {
        background: #e6f4ff;
        color: var(--tvk-blue);
      }

      .faq-answer {
        padding: 12px 16px 14px;
        background: #fff;
        font-size: 0.9rem;
        line-height: 1.58;
        color: #334155;
        border-top: 1px solid var(--border);
        overflow-wrap: anywhere;
      }

      .related-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-width: 100%;
      }

      .related-link {
        text-decoration: none;
        background: #f8fafc;
        border: 1px solid var(--border);
        color: var(--tvk-navy);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 7px 12px;
        border-radius: 8px;
        transition: all 0.15s ease;
        max-width: 100%;
        overflow-wrap: anywhere;
      }

      .related-link:hover {
        border-color: var(--tvk-sky);
        background: #e6f4ff;
        color: var(--tvk-blue);
      }

      /* Footer Gaya Traveloka */
      .site-footer {
        width: 100%;
        background: var(--tvk-navy);
        color: #e2e8f0;
        border-top: 1px solid var(--border);
        padding: 36px 20px 28px;
        margin-top: auto;
        overflow-x: clip;
      }

      .footer-inner {
        max-width: 1180px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        min-width: 0;
      }

      .footer-inner > div:first-child {
        min-width: 0;
        max-width: 100%;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 1.15rem;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 8px;
      }

      .footer-logo {
        width: 28px;
        height: 28px;
        display: block;
        flex-shrink: 0;
      }

      .footer-brand span {
        color: #7dd3fc;
      }

      .footer-copy {
        margin: 0;
        font-size: 0.84rem;
        color: #cbd5e1;
        max-width: 440px;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
        max-width: 100%;
      }

      .footer-links a {
        color: #ffffff;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
        transition: color 0.15s ease;
        overflow-wrap: anywhere;
      }

      .footer-links a:hover {
        color: #7dd3fc;
        text-decoration: underline;
      }

      .footer-bottom {
        max-width: 1180px;
        width: 100%;
        margin: 24px auto 0;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        overflow-wrap: anywhere;
      }

      @media (max-width: 900px) {
        .villa-card {
          grid-template-columns: 240px minmax(0, 1fr);
          height: auto;
        }

        .villa-media-col {
          width: 240px;
          height: auto;
        }

        .main-photo-box {
          height: 158px;
        }

        .villa-info {
          border-right: none;
        }

        .villa-price-col {
          grid-column: 1 / -1;
          border-top: 1px solid var(--border);
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          text-align: left;
        }

        .cta-btn {
          width: auto;
          margin-top: 0;
        }
      }

      @media (max-width: 640px) {
        .topbar {
          padding: 11px 12px;
        }

        .brand {
          font-size: 1.12rem;
          gap: 7px;
        }

        .brand-logo {
          width: 30px;
          height: 30px;
        }

        .topbar-badge {
          display: none;
        }

        .menu-toggle-btn {
          display: inline-flex;
        }

        .topbar-right {
          position: static;
          gap: 0;
        }

        .topbar-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          z-index: 50;
          background: #ffffff;
          border-bottom: 1px solid var(--border);
          box-shadow: 0 12px 24px rgba(12, 44, 87, 0.12);
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 6px 12px 10px;
        }

        .topbar-nav.is-open {
          display: flex;
        }

        .topbar-nav a {
          padding: 11px 12px;
          border-radius: 8px;
          font-size: 0.9rem;
        }

        .topbar-nav a:hover {
          background: #f0f9ff;
        }

        .hero {
          padding: 22px 12px 36px;
        }

        .container {
          padding: 0 12px 48px;
        }

        .topic-nav-wrap {
          padding: 0 12px;
        }

        .villa-card {
          grid-template-columns: minmax(0, 1fr);
          height: auto;
        }

        .villa-media-col {
          width: 100%;
          height: auto;
          border-right: none;
        }

        .main-photo-box {
          height: auto;
          aspect-ratio: 16 / 10;
        }

        .gallery-strip {
