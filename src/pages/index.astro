---
import type { ImageMetadata } from "astro";
import datavilla from "../data/datavilla.json";

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="2" y="2" width="60" height="60" rx="16" fill="#0770cd"/><path d="M14 33 L32 16 L50 33" fill="none" stroke="#ff5e1f" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 31 V44 H43 V31" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 51 Q24 47 32 51 T48 51" fill="none" stroke="#7dd3fc" stroke-width="3.8" stroke-linecap="round"/></svg>`;
const faviconDataUri = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

interface Villa {
  id: string;
  name: string;
  location: string;
  price_per_night: number;
  kapasitas_maks: number;
  jumlah_kamar: number;
  rating: number;
  jumlah_ulasan: number;
  deskripsi_singkat?: string;
  deskripsi_panjang?: string;
  halaman_luas?: boolean;
  pet_friendly?: boolean;
  view_gunung?: boolean;
  desain_klasik?: boolean;
  private_pool?: boolean;
  karaoke?: boolean;
  meja_biliar?: boolean;
  mewah?: boolean;
  fasilitas?: string[];
  wisata_terdekat?: string[];
  restoran_terdekat?: string[];
  main_photo_url?: string;
  gallery_urls?: string[];
}

// --- LOGIKA MAPPING GAMBAR LOKAL ---
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/villas/**/*.{jpeg,jpg,png,webp}",
  { eager: true }
);

function getLocalAsset(cloudinaryUrl?: string): ImageMetadata | null {
  if (!cloudinaryUrl) return null;
  try {
    const parts = cloudinaryUrl.split(/\/v\d+\//);
    if (parts.length < 2) return null;
    const fileName = decodeURIComponent(parts[1]);
    const webpPath = fileName.replace(/\.[^/.]+$/, "") + ".webp";
    const localPath = `/src/assets/villas/${webpPath}`;
    const asset = localImages[localPath];
    return asset ? asset.default : null;
  } catch {
    return null;
  }
}

const villas = (Array.isArray(datavilla) ? datavilla : []) as Villa[];
const fallbackImage = "https://placehold.co/800x500/e2e8f0/334155?text=Akang+Villa+Puncak";
const PAGE_SIZE = 10;
const MAX_PHOTOS_PER_VILLA = 4;

const slugify = (text: string) =>
  (text || "")
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const buildPrimarySlug = (v: Villa, index: number) => {
  const idClean = (v.id || "").trim().toLowerCase();
  const nameSlug = slugify(v.name || "");

  if (idClean && nameSlug && slugify(idClean).includes(nameSlug)) {
    return slugify(idClean);
  }
  if (idClean && nameSlug) {
    return `${slugify(idClean)}-${nameSlug}`;
  }
  if (idClean) {
    return slugify(idClean);
  }
  if (nameSlug) {
    return nameSlug;
  }
  return `villa-${index + 1}`;
};

const usedSlugs = new Set<string>();
const villaSlugs = villas.map((villa, idx) => {
  let baseSlug = buildPrimarySlug(villa, idx);
  if (!baseSlug) baseSlug = `villa-${idx + 1}`;

  let finalSlug = baseSlug;
  let counter = 2;
  while (usedSlugs.has(finalSlug)) {
    finalSlug = `${baseSlug}-${counter}`;
    counter++;
  }
  usedSlugs.add(finalSlug);
  return finalSlug;
});

const uniqueLocations = Array.from(
  new Set(villas.map((v) => v.location?.trim()).filter(Boolean))
).sort((a, b) => a.localeCompare(b, "id"));

function formatRupiah(angka: number): string {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(angka || 0);
}

function getRatingLabel(rating: number): string {
  if (rating >= 4.8) return "Mengesankan";
  if (rating >= 4.5) return "Sangat bagus";
  if (rating >= 4.0) return "Bagus";
  return "Nyaman";
}

function resolveSingleUrl(rawUrl?: string): string {
  if (!rawUrl || !rawUrl.trim()) return fallbackImage;
  const trimmed = rawUrl.trim();
  const localAsset = getLocalAsset(trimmed);
  if (localAsset) return localAsset.src;
  if (trimmed.startsWith("public/")) {
    return "/" + trimmed.slice("public/".length);
  }
  return trimmed;
}

function resolveVillaGallery(villa: Villa): {
  mainSrc: string;
  photos: string[];
} {
  const combined = [villa.main_photo_url, ...(villa.gallery_urls || [])].filter(
    (u): u is string => Boolean(u && u.trim())
  );
  const uniqueRaw = Array.from(new Set(combined)).slice(0, MAX_PHOTOS_PER_VILLA);
  const resolved = uniqueRaw.map((u) => resolveSingleUrl(u));
  const photos = resolved.length > 0 ? resolved : [fallbackImage];
  return {
    mainSrc: photos[0],
    photos,
  };
}

function normalizeFacilities(rawFasilitas?: string[]): string[] {
  if (!Array.isArray(rawFasilitas) || rawFasilitas.length === 0) return [];
  const knownItems = [
    "Private Pool",
    "Kolam Renang Pribadi",
    "WiFi Gratis",
    "Free WiFi",
    "Area Parkir",
    "BBQ",
    "Area BBQ",
    "Area Taman/Halaman",
    "Halaman Luas",
    "AC",
    "Water Heater (Pemanas Air)",
    "Water Heater",
    "Dapur Lengkap",
    "Kulkas",
    "Dispenser Air",
    "Peralatan Masak",
    "Peralatan Makan",
    "TV Layar Datar",
    "Karaoke",
    "Meja Biliar",
    "Biliar",
    "Set Kursi & Meja Makan",
    "Sofa Ruang Tamu",
  ];

  const items: string[] = [];
  for (const entry of rawFasilitas) {
    if (!entry) continue;
    const text = entry.trim();
    if (text.length > 48) {
      let matchedAny = false;
      for (const known of knownItems) {
        if (text.toLowerCase().includes(known.toLowerCase()) && !items.includes(known)) {
          items.push(known);
          matchedAny = true;
        }
      }
      if (!matchedAny) items.push(text);
    } else if (!items.includes(text)) {
      items.push(text);
    }
  }
  return items;
}

function getHighlights(villa: Villa): string[] {
  const tags: string[] = [];
  if (villa.private_pool) tags.push("Private Pool");
  if (villa.view_gunung) tags.push("View Gunung");
  if (villa.halaman_luas) tags.push("Halaman Luas");
  if (villa.karaoke) tags.push("Karaoke");
  if (villa.meja_biliar) tags.push("Biliar");
  if (villa.pet_friendly) tags.push("Pet Friendly");
  if (villa.mewah) tags.push("Mewah");
  if (villa.desain_klasik) tags.push("Desain Klasik");
  if (tags.length === 0) {
    return normalizeFacilities(villa.fasilitas).slice(0, 3);
  }
  return tags.slice(0, 3);
}

// --- KATEGORI LOKASI (GAMBAR DIAMBIL DARI VILLA) ---
const locationCards = uniqueLocations.map((loc, idx) => {
  const matched = villas.filter(
    (v) => (v.location || "").trim().toLowerCase() === loc.toLowerCase()
  );
  const sampleVilla = matched[0] || villas[idx % Math.max(1, villas.length)];
  const photo = sampleVilla ? resolveVillaGallery(sampleVilla).mainSrc : fallbackImage;
  const minPrice =
    matched.length > 0
      ? Math.min(...matched.map((v) => Number(v.price_per_night) || 0).filter((p) => p > 0))
      : 0;
  return {
    location: loc,
    count: matched.length,
    photo,
    minPriceFormatted: minPrice > 0 ? formatRupiah(minPrice) : "",
  };
});

// --- KATEGORI PILIHAN HARGA (GAMBAR DIAMBIL DARI VILLA) ---
function pickVillaPhotoByCondition(
  predicate: (v: Villa) => boolean,
  fallbackIndex: number
): string {
  const found = villas.find((v) => predicate(v) && Boolean(v.main_photo_url || v.gallery_urls?.[0]));
  if (found) return resolveVillaGallery(found).mainSrc;
  const fallbackVilla = villas[fallbackIndex % Math.max(1, villas.length)];
  return fallbackVilla ? resolveVillaGallery(fallbackVilla).mainSrc : fallbackImage;
}

const priceCategoryCards = [
  {
    key: "under-1500k",
    title: "Hemat & Keluarga",
    rangeLabel: "Di bawah Rp 1.500.000 / malam",
    subtitle: "Cocok untuk liburan keluarga kecil & akhir pekan santai",
    photo: pickVillaPhotoByCondition(
