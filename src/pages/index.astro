    rangeLabel: "Rp 3.000.000 – Rp 5.000.000 / malam",
    subtitle: "Ruang luas untuk kumpul keluarga besar, acara kantor & kolam renang",
    photo: pickVillaPhotoByCondition(
      (v) =>
        Number(v.price_per_night) > 3000000 && Number(v.price_per_night) <= 5000000,
      2
    ),
  },
  {
    key: "above-5000k",
    title: "Premium & Eksklusif",
    rangeLabel: "Di atas Rp 5.000.000 / malam",
    subtitle: "Villa kapasitas besar & fasilitas ekstra untuk pengalaman istimewa",
    photo: pickVillaPhotoByCondition((v) => Number(v.price_per_night) > 5000000, 3),
  },
];

const whyChooseUsItems = [
  {
    title: "Pilihan Villa Terkurasi di Puncak",
    desc: "Mencakup area Puncak, Cipanas, Cisarua, dan Kota Bunga untuk kebutuhan keluarga maupun rombongan.",
  },
  {
    title: "Informasi Harga & Kapasitas Jelas",
    desc: "Detail jumlah kamar, maksimal tamu, fasilitas, dan harga per malam ditampilkan transparan sejak awal.",
  },
  {
    title: "Rekomendasi Sesuai Kebutuhan",
    desc: "Mudah menyaring villa berdasarkan lokasi, rentang harga, kapasitas tamu, maupun fasilitas favorit.",
  },
  {
    title: "Respon Cepat & Booking Langsung",
    desc: "Bantuan cek ketersediaan tanggal dan konfirmasi pemesanan langsung melalui WhatsApp.",
  },
];

const faqItems = [
  {
    q: "Bagaimana cara memesan villa di villa.web.id?",
    a: "Pilih villa yang diinginkan, buka halaman detailnya, lalu klik tombol booking via WhatsApp untuk mengecek ketersediaan tanggal dan mendapatkan panduan pembayaran.",
  },
  {
    q: "Area mana saja yang tersedia untuk sewa villa?",
    a: "Tersedia pilihan villa di berbagai titik kawasan Puncak, Cipanas, Cisarua, dan Kota Bunga. Anda bisa memilih langsung pada section Pilihan Lokasi atau dropdown lokasi.",
  },
  {
    q: "Apakah bisa mencari villa berdasarkan budget dan jumlah tamu?",
