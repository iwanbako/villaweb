---
export const prerender = true;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Halaman Tidak Ditemukan | akangvillapuncak.com</title>
    <meta
      name="description"
      content="Maaf, halaman yang Anda cari tidak dapat ditemukan di akangvillapuncak.com."
    />
    <meta name="robots" content="noindex, follow" />
    <style>
      :root {
        --tvk-sky: #0194f3;
        --tvk-blue: #0770cd;
        --tvk-navy: #0c2c57;
        --tvk-orange: #ff5e1f;
        --tvk-orange-dark: #e64d12;
        --bg: #f4f7fa;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
      }

      /* Topbar Gaya Traveloka */
      .topbar {
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        padding: 13px 20px;
        position: relative;
      }

      .topbar-inner {
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
      }

      .brand {
        font-size: 1.3rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        color: var(--tvk-sky);
        text-decoration: none;
        flex-shrink: 0;
      }

      .brand span {
        color: var(--tvk-navy);
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .topbar-nav {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      .topbar-nav a {
        color: var(--text);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 600;
        transition: color 0.15s ease;
      }

      .topbar-nav a:hover {
        color: var(--tvk-sky);
      }

      .topbar-badge {
        background: #e6f4ff;
        color: var(--tvk-blue);
        border: 1px solid #bae6fd;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 5px 11px;
        border-radius: 999px;
        white-space: nowrap;
      }

      .menu-toggle-btn {
        display: none;
        background: #f8fafc;
        border: 1px solid var(--border);
        color: var(--tvk-navy);
        width: 38px;
        height: 38px;
        border-radius: 8px;
        font-size: 1.2rem;
        line-height: 1;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.15s ease, border-color 0.15s ease;
      }

      .menu-toggle-btn:hover {
        background: #e6f4ff;
        border-color: var(--tvk-sky);
        color: var(--tvk-blue);
      }

      /* Konten 404 */
      .page-404 {
        flex: 1 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 20px;
      }

      .box-404 {
        max-width: 480px;
        width: 100%;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 36px 28px;
        text-align: center;
        box-shadow: 0 10px 28px rgba(12, 44, 87, 0.06);
      }

      .code-wrap {
        position: relative;
        margin-bottom: 24px;
      }

      .code-bg {
        margin: 0;
        font-size: clamp(104px, 20vw, 144px);
        font-weight: 900;
        color: rgba(1, 148, 243, 0.1);
        line-height: 1;
        user-select: none;
      }

      .code-icon-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .code-icon {
        width: 72px;
        height: 72px;
        color: var(--tvk-orange);
        filter: drop-shadow(0 8px 14px rgba(12, 44, 87, 0.14));
      }

      .title-404 {
        margin: 0 0 12px;
        font-size: clamp(1.45rem, 3.6vw, 1.85rem);
        font-weight: 800;
        color: var(--tvk-navy);
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .title-404 span {
        color: var(--tvk-orange);
      }

      .desc-404 {
        margin: 0 0 28px;
        color: var(--muted);
        font-weight: 500;
        font-size: 0.92rem;
        line-height: 1.65;
      }

      .actions-404 {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
      }

      .btn-home {
        display: inline-block;
        width: 100%;
        background-color: var(--tvk-sky);
        color: #ffffff;
        text-decoration: none;
        padding: 13px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.92rem;
        box-shadow: 0 8px 18px rgba(1, 148, 243, 0.22);
        transition: background-color 0.15s ease, transform 0.12s ease;
      }

      .btn-home:hover {
        background-color: var(--tvk-blue);
      }

      .btn-home:active {
        transform: scale(0.98);
      }

      .link-wa {
        margin-top: 4px;
        color: #15803d;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.84rem;
      }

      .link-wa:hover {
        text-decoration: underline;
      }

      /* Footer Gaya Traveloka */
      .site-footer {
        background: var(--tvk-navy);
        color: #e2e8f0;
        border-top: 1px solid var(--border);
        padding: 36px 20px 28px;
        margin-top: auto;
      }

      .footer-inner {
        max-width: 1180px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
      }

      .footer-brand {
        font-size: 1.2rem;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 6px;
      }

      .footer-brand span {
        color: #7dd3fc;
      }

      .footer-copy {
        margin: 0;
        font-size: 0.84rem;
        color: #cbd5e1;
        max-width: 440px;
        line-height: 1.55;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
      }

      .footer-links a {
        color: #ffffff;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
        transition: color 0.15s ease;
      }

      .footer-links a:hover {
        color: #7dd3fc;
        text-decoration: underline;
      }

      .footer-bottom {
        max-width: 1180px;
        margin: 24px auto 0;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
      }

      @media (max-width: 640px) {
        .topbar {
          padding: 11px 16px;
        }

        .topbar-badge {
          display: none;
        }

        .menu-toggle-btn {
          display: inline-flex;
        }

        .topbar-right {
          position: static;
          gap: 0;
        }

        .topbar-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          z-index: 50;
          background: #ffffff;
          border-bottom: 1px solid var(--border);
          box-shadow: 0 12px 24px rgba(12, 44, 87, 0.12);
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 6px 12px 10px;
        }

        .topbar-nav.is-open {
          display: flex;
        }

        .topbar-nav a {
          padding: 11px 12px;
          border-radius: 8px;
          font-size: 0.9rem;
        }

        .topbar-nav a:hover {
          background: #f0f9ff;
        }

        .page-404 {
          padding: 32px 12px;
        }

        .box-404 {
          padding: 28px 20px;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">villa.web.id</a>
        <div class="topbar-right">
          <nav id="topbar-nav" class="topbar-nav" aria-label="Navigasi utama">
            <a href="/cara-pesan">Cara Pesan</a>
            <a href="/bantuan">Bantuan</a>
            <a href="/kontak">Kontak</a>
            <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
          </nav>
          <span class="topbar-badge">Sewa Villa Puncak, Cipanas &amp; Kota Bunga</span>
          <button
            type="button"
            id="menu-toggle-btn"
            class="menu-toggle-btn"
            aria-label="Buka menu navigasi"
            aria-expanded="false"
            aria-controls="topbar-nav"
          >
            &#9776;
          </button>
        </div>
      </div>
    </header>

    <main class="page-404">
      <div class="box-404">
        <div class="code-wrap">
          <h1 class="code-bg">404</h1>
          <div class="code-icon-overlay">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="code-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M14.5,6L20,16H18L14.5,9.5L11,16H9L14.5,6M7,10L12,20H10L7,14L4,20H2L7,10Z" />
            </svg>
          </div>
        </div>

        <h2 class="title-404">
          Yah, Halaman <span>Hilang!</span>
        </h2>
        <p class="desc-404">
          Maaf, halaman yang Anda tuju mungkin sudah pindah atau tidak pernah ada. Mari kembali ke daftar villa di kawasan Puncak.
        </p>

        <div class="actions-404">
          <a href="/" class="btn-home">
            Kembali ke Beranda
          </a>
          <a
            href="https://wa.me/6285938573419?text=Halo%20Admin%20Akang%20Villa%20Puncak%2C%20saya%20ingin%20tanya%20ketersediaan%20villa%20untuk%20rencana%20menginap.%20Bisa%20dibantu%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="link-wa"
          >
            Tanya Admin via WhatsApp
          </a>
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">villa.web.id</div>
          <p class="footer-copy">
            Layanan sewa villa di kawasan Puncak, Cipanas, Cisarua, dan Kota Bunga dengan proses booking jelas dan transparan.
          </p>
        </div>
        <nav class="footer-links" aria-label="Tautan informasi">
          <a href="/cara-pesan">Cara Pesan</a>
          <a href="/bantuan">Bantuan</a>
          <a href="/kontak">Kontak</a>
          <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>akangvillapuncak.com</span>
        <span>Puncak • Cipanas • Cisarua • Kota Bunga</span>
      </div>
    </footer>

    <script is:inline>
      const menuToggleBtn = document.getElementById("menu-toggle-btn");
      const topbarNav = document.getElementById("topbar-nav");

      function setMobileMenuOpen(isOpen) {
        if (!topbarNav || !menuToggleBtn) return;
        topbarNav.classList.toggle("is-open", isOpen);
        menuToggleBtn.setAttribute("aria-expanded", String(isOpen));
        menuToggleBtn.innerHTML = isOpen ? "&times;" : "&#9776;";
        menuToggleBtn.setAttribute(
          "aria-label",
          isOpen ? "Tutup menu navigasi" : "Buka menu navigasi"
        );
      }

      menuToggleBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = topbarNav?.classList.contains("is-open") || false;
        setMobileMenuOpen(!isOpen);
      });

      topbarNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMobileMenuOpen(false));
      });

      document.addEventListener("click", (e) => {
        if (!topbarNav?.classList.contains("is-open")) return;
        const target = e.target;
        if (target instanceof Node && !topbarNav.contains(target) && target !== menuToggleBtn) {
          setMobileMenuOpen(false);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMobileMenuOpen(false);
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 640) setMobileMenuOpen(false);
      });
    </script>
  </body>
</html>