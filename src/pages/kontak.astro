    <script is:inline define:vars={{ waAdmin }}>
      const menuToggleBtn = document.getElementById("menu-toggle-btn");
      const topbarNav = document.getElementById("topbar-nav");
      const topbarEl = document.getElementById("topbar");

      function setMobileMenuOpen(isOpen) {
        if (!topbarNav || !menuToggleBtn) return;
        topbarNav.classList.toggle("is-open", isOpen);
        menuToggleBtn.setAttribute("aria-expanded", String(isOpen));
        menuToggleBtn.innerHTML = isOpen ? "&times;" : "&#9776;";
        menuToggleBtn.setAttribute(
          "aria-label",
          isOpen ? "Tutup menu navigasi" : "Buka menu navigasi"
        );
      }

      menuToggleBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = topbarNav?.classList.contains("is-open") || false;
        setMobileMenuOpen(!isOpen);
      });

      topbarNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMobileMenuOpen(false));
      });

      document.addEventListener("click", (e) => {
        if (!topbarNav?.classList.contains("is-open")) return;
        const target = e.target;
        if (target instanceof Node && !topbarNav.contains(target) && target !== menuToggleBtn) {
          setMobileMenuOpen(false);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMobileMenuOpen(false);
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 640) setMobileMenuOpen(false);
      });

      function handleStickyHeader() {
        if (!topbarEl) return;
        topbarEl.classList.toggle("is-stuck", window.scrollY > 4);
      }

      window.addEventListener("scroll", handleStickyHeader, { passive: true });
      handleStickyHeader();

      if (window.location.search) {
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
      }

      const form = document.getElementById("wa-form");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();

          const namaEl = document.getElementById("nama");
          const telpEl = document.getElementById("telp");
          const subjekEl = document.getElementById("subjek");
          const pesanEl = document.getElementById("pesan");

          const nama = namaEl ? namaEl.value.trim() : "";
          const telp = telpEl ? telpEl.value.trim() : "";
          const subjek = subjekEl ? subjekEl.value : "";
          const pesan = pesanEl ? pesanEl.value.trim() : "";

          const teks = `Halo Admin villa.web.id,%0A%0A*Ada Pesan Baru dari Website*%0A----------------------------%0A*Nama:* ${encodeURIComponent(nama)}%0A*WhatsApp:* ${encodeURIComponent(telp)}%0A*Subjek:* ${encodeURIComponent(subjek)}%0A*Pesan:* ${encodeURIComponent(pesan)}%0A----------------------------`;

          const url = `https://wa.me/${waAdmin}?text=${teks}`;
          window.open(url, "_blank", "noopener,noreferrer");
        });
      }
    </script>
  </body>
</html>