import type { ImageMetadata } from "astro";
import datavilla from "../../data/datavilla.json";

export const prerender = true;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="2" y="2" width="60" height="60" rx="16" fill="#0770cd"/><path d="M14 33 L32 16 L50 33" fill="none" stroke="#ff5e1f" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 31 V44 H43 V31" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 51 Q24 47 32 51 T48 51" fill="none" stroke="#7dd3fc" stroke-width="3.8" stroke-linecap="round"/></svg>`;
const faviconDataUri = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

interface Villa {
  id: string;
  name: string;
  location: string;
  price_per_night: number;
  kapasitas_maks: number;
  jumlah_kamar: number;
  rating: number;
  jumlah_ulasan: number;
  deskripsi_singkat?: string;
  deskripsi_panjang?: string;
  halaman_luas?: boolean;
  pet_friendly?: boolean;
  view_gunung?: boolean;
  desain_klasik?: boolean;
  private_pool?: boolean;
  karaoke?: boolean;
  meja_biliar?: boolean;
  mewah?: boolean;
  fasilitas?: string[];
  wisata_terdekat?: string[];
  restoran_terdekat?: string[];
  main_photo_url?: string;
  gallery_urls?: string[];
}

function randomRatingCount(min = 6500, max = 15000): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

export function getStaticPaths() {
  const allVillas = (Array.isArray(datavilla) ? datavilla : []) as Villa[];

  const slugify = (text: string) =>
    (text || "")
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const buildPrimarySlug = (v: Villa, index: number) => {
    const idClean = (v.id || "").trim().toLowerCase();
    const nameSlug = slugify(v.name || "");

    if (idClean && nameSlug && slugify(idClean).includes(nameSlug)) {
      return slugify(idClean);
    }
    if (idClean && nameSlug) {
      return `${slugify(idClean)}-${nameSlug}`;
    }
    if (idClean) {
      return slugify(idClean);
    }
    if (nameSlug) {
      return nameSlug;
    }
    return `villa-${index + 1}`;
  };

  const usedSlugs = new Set<string>();
  const entries = allVillas.map((villa, idx) => {
    let baseSlug = buildPrimarySlug(villa, idx);
    if (!baseSlug) baseSlug = `villa-${idx + 1}`;

    let finalSlug = baseSlug;
    let counter = 2;
    while (usedSlugs.has(finalSlug)) {
      finalSlug = `${baseSlug}-${counter}`;
      counter++;
    }
    usedSlugs.add(finalSlug);

    return { villa, slug: finalSlug };
  });

  const RELATED_COUNT = 6;
  const totalEntries = entries.length;

  const appearanceCount = new Map<string, number>();
  for (const item of entries) {
    appearanceCount.set(item.slug, 0);
  }

  function scoreSimilarity(source: Villa, candidate: Villa): number {
    let score = 0;
    const srcLoc = (source.location || "").trim().toLowerCase();
    const candLoc = (candidate.location || "").trim().toLowerCase();
    if (srcLoc && candLoc && srcLoc === candLoc) score += 20;
    if (source.private_pool && candidate.private_pool) score += 6;
    if (source.view_gunung && candidate.view_gunung) score += 5;
    if (source.halaman_luas && candidate.halaman_luas) score += 4;
    if (source.jumlah_kamar && candidate.jumlah_kamar === source.jumlah_kamar) score += 3;
    return score;
  }

  return entries.map(({ villa, slug }, sourceIdx) => {
    const candidates = entries.filter((item) => item.slug !== slug);

    candidates.sort((a, b) => {
      const countA = appearanceCount.get(a.slug) || 0;
      const countB = appearanceCount.get(b.slug) || 0;
      if (countA !== countB) return countA - countB;

      const simDiff = scoreSimilarity(villa, b.villa) - scoreSimilarity(villa, a.villa);
      if (simDiff !== 0) return simDiff;

      const idxA = entries.findIndex((e) => e.slug === a.slug);
      const idxB = entries.findIndex((e) => e.slug === b.slug);
      const distA = (idxA - sourceIdx + totalEntries) % totalEntries;
      const distB = (idxB - sourceIdx + totalEntries) % totalEntries;
      return distA - distB;
    });

    const picked = candidates.slice(0, Math.min(RELATED_COUNT, candidates.length));
    for (const p of picked) {
      appearanceCount.set(p.slug, (appearanceCount.get(p.slug) || 0) + 1);
    }

    return {
      params: { id: slug },
      props: {
        villa,
        villaSlug: slug,
        relatedVillas: picked.map((rv) => ({
          slug: rv.slug,
          name: rv.villa.name,
          location: rv.villa.location,
          price_per_night: rv.villa.price_per_night,
          jumlah_kamar: rv.villa.jumlah_kamar,
          kapasitas_maks: rv.villa.kapasitas_maks,
          main_photo_url: rv.villa.main_photo_url,
          gallery_urls: rv.villa.gallery_urls,
        })),
      },
    };
  });
}

interface RelatedVillaItem {
  slug: string;
  name: string;
  location: string;
  price_per_night: number;
  jumlah_kamar: number;
  kapasitas_maks: number;
  main_photo_url?: string;
  gallery_urls?: string[];
}

interface Props {
  villa: Villa;
  villaSlug: string;
  relatedVillas: RelatedVillaItem[];
}

const { villa, villaSlug, relatedVillas } = Astro.props;
const ratingCountRandom = randomRatingCount(6500, 15000);

// --- LOGIKA MAPPING GAMBAR LOKAL ---
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/villas/**/*.{jpeg,jpg,png,webp}",
  { eager: true }
);

function getLocalAsset(cloudinaryUrl?: string): ImageMetadata | null {
  if (!cloudinaryUrl) return null;
  try {
    const parts = cloudinaryUrl.split(/\/v\d+\//);
    if (parts.length < 2) return null;
    const fileName = decodeURIComponent(parts[1]);
    const webpPath = fileName.replace(/\.[^/.]+$/, "") + ".webp";
    const localPath = `/src/assets/villas/${webpPath}`;
    const asset = localImages[localPath];
    return asset ? asset.default : null;
  } catch {
    return null;
  }
}

const fallbackImage = "https://placehold.co/800x500/e2e8f0/334155?text=Akang+Villa+Puncak";

function formatRupiah(angka: number): string {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(angka || 0);
}

function getRatingLabel(rating: number): string {
  if (rating >= 4.8) return "Mengesankan";
  if (rating >= 4.5) return "Sangat bagus";
  if (rating >= 4.0) return "Bagus";
  return "Nyaman";
}

function resolveSingleUrl(rawUrl?: string): string {
  if (!rawUrl || !rawUrl.trim()) return fallbackImage;
  const trimmed = rawUrl.trim();
  const localAsset = getLocalAsset(trimmed);
  if (localAsset) return localAsset.src;
  if (trimmed.startsWith("public/")) {
    return "/" + trimmed.slice("public/".length);
  }
  return trimmed;
}

function resolveAllGalleryUrls(v: { main_photo_url?: string; gallery_urls?: string[] }): string[] {
  const combined = [v.main_photo_url, ...(v.gallery_urls || [])].filter(
    (u): u is string => Boolean(u && u.trim())
  );
  const uniqueRaw = Array.from(new Set(combined));
  const resolved = uniqueRaw.map((u) => resolveSingleUrl(u));
  return resolved.length > 0 ? resolved : [fallbackImage];
}

function normalizeFacilities(rawFasilitas?: string[]): string[] {
  if (!Array.isArray(rawFasilitas) || rawFasilitas.length === 0) return [];
  const knownItems = [
    "Private Pool",
    "Kolam Renang Pribadi",
    "WiFi Gratis",
    "Free WiFi",
    "Area Parkir",
    "BBQ",
    "Area BBQ",
    "Area Taman/Halaman",
    "Halaman Luas",
    "AC",
    "Water Heater (Pemanas Air)",
    "Water Heater",
    "Dapur Lengkap",
    "Kulkas",
    "Dispenser Air",
    "Peralatan Masak",
    "Peralatan Makan",
    "TV Layar Datar",
    "Karaoke",
    "Meja Biliar",
    "Biliar",
    "Set Kursi & Meja Makan",
    "Sofa Ruang Tamu",
  ];

  const items: string[] = [];
  for (const entry of rawFasilitas) {
    if (!entry) continue;
    const text = entry.trim();
    if (text.length > 48) {
      let matchedAny = false;
      for (const known of knownItems) {
        if (text.toLowerCase().includes(known.toLowerCase()) && !items.includes(known)) {
          items.push(known);
          matchedAny = true;
        }
      }
      if (!matchedAny) items.push(text);
    } else if (!items.includes(text)) {
      items.push(text);
    }
  }
  return items;
}

const galleryPhotos = resolveAllGalleryUrls(villa);
const mainPhoto = galleryPhotos[0] || fallbackImage;

const facilities = normalizeFacilities(villa.fasilitas);
const wisataList = Array.isArray(villa.wisata_terdekat) ? villa.wisata_terdekat : [];
const restoList = Array.isArray(villa.restoran_terdekat) ? villa.restoran_terdekat : [];
const descriptionText = villa.deskripsi_panjang || villa.deskripsi_singkat || "";
const priceFormatted = formatRupiah(villa.price_per_night);

const mapQuery = encodeURIComponent(`${villa.name} ${villa.location || "Puncak"}`);
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapQuery}&t=&z=15&ie=UTF8&iwloc=&output=embed`;

const siteOrigin = "https://villa.web.id";
const canonicalUrl = `${siteOrigin}/villa/${villaSlug}`;
const pageTitle = `${villa.name} (${villa.location}) — villa.web.id`;
const pageDescription =
  villa.deskripsi_singkat ||
  `Sewa ${villa.name} di ${villa.location}, ${villa.jumlah_kamar} kamar tidur, kapasitas maksimal ${villa.kapasitas_maks} tamu. Harga mulai ${priceFormatted}/malam.`;

const schemaPhoto =
  mainPhoto && !mainPhoto.startsWith("https://placehold.co")
    ? new URL(mainPhoto, siteOrigin).toString()
    : `${siteOrigin}/og-image.jpg`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${villa.name} — ${villa.location}`,
  image: schemaPhoto,
  description:
    villa.deskripsi_singkat ||
    `Sewa ${villa.name} di ${villa.location}, kapasitas maksimal ${villa.kapasitas_maks} tamu, ${villa.jumlah_kamar} kamar tidur. Harga mulai ${priceFormatted}/malam di villa.web.id.`,
  brand: {
    "@type": "Brand",
    name: "villa.web.id",
  },
  offers: {
    "@type": "Offer",
    url: canonicalUrl,
    priceCurrency: "IDR",
    price: villa.price_per_night || 0,
    availability: "https://schema.org/InStock",
    priceValidUntil: "2027-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: villa.rating || 4.9,
    bestRating: 5,
    worstRating: 1,
    ratingCount: ratingCountRandom,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: `${siteOrigin}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: villa.location || "Puncak",
      item: `${siteOrigin}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: villa.name,
      item: canonicalUrl,
    },
  ],
};
