      .spec-chip {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        color: var(--navy);
        font-size: 0.84rem;
        font-weight: 700;
        padding: 7px 12px;
        border-radius: 999px;
        max-width: 100%;
        overflow-wrap: anywhere;
      }

      .booking-panel {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        max-width: 100%;
        min-width: 0;
      }

      .price-meta {
        text-align: right;
        min-width: 0;
      }

      .price-label {
        display: block;
        font-size: 0.75rem;
        color: var(--muted);
      }

      .price-amount {
        font-size: 1.42rem;
        font-weight: 900;
        color: var(--orange);
        line-height: 1.15;
        overflow-wrap: anywhere;
      }

      .btn-wa {
        background: var(--green);
        color: #fff;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .btn-wa:hover {
        background: var(--green-dark);
      }

      .section-heading {
        margin: 0 0 12px;
        font-size: 1.06rem;
        font-weight: 800;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: 8px;
        overflow-wrap: anywhere;
      }

      .section-heading::before {
        content: "";
        width: 4px;
        height: 18px;
        border-radius: 999px;
        background: var(--sky);
        display: inline-block;
        flex-shrink: 0;
      }

      .desc-body {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #334155;
        white-space: pre-line;
        overflow-wrap: anywhere;
      }

      .facility-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-width: 100%;
      }

      .facility-badge {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        color: #0369a1;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        max-width: 100%;
        overflow-wrap: anywhere;
      }

      .map-locked-wrap {
        position: relative;
        width: 100%;
        height: 300px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border);
        background: #e2e8f0;
        user-select: none;
        -webkit-user-select: none;
      }

      .map-locked-wrap iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
        pointer-events: none;
      }

      .map-click-shield {
        position: absolute;
        inset: 0;
        z-index: 5;
        cursor: default;
        background: transparent;
      }

      .map-caption {
        margin-top: 8px;
        font-size: 0.82rem;
        color: var(--muted);
        overflow-wrap: anywhere;
      }

      .nearby-two-col {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        width: 100%;
      }

      .nearby-card {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 18px;
        min-width: 0;
        overflow-x: clip;
      }

      .nearby-list {
        margin: 0;
        padding-left: 18px;
        font-size: 0.88rem;
        color: #334155;
        line-height: 1.65;
        overflow-wrap: anywhere;
      }

      .nearby-list li + li {
        margin-top: 4px;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        width: 100%;
      }

      .rel-card {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        min-width: 0;
        transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      }

      .rel-card:hover {
        border-color: var(--sky);
        transform: translateY(-2px);
        box-shadow: var(--shadow-sm);
      }

      .rel-card img {
        display: block;
        width: 100%;
        height: 148px;
        object-fit: cover;
        background: #e2e8f0;
      }

      .rel-body {
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
      }

      .rel-title {
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--text);
        line-height: 1.3;
        overflow-wrap: anywhere;
      }

      .rel-loc {
        font-size: 0.8rem;
        color: var(--muted);
        overflow-wrap: anywhere;
      }

      .rel-price {
        margin-top: 6px;
        font-weight: 800;
        font-size: 0.94rem;
        color: var(--orange);
        overflow-wrap: anywhere;
      }

      .site-footer {
        width: 100%;
        background: var(--navy);
        color: #e2e8f0;
        border-top: 1px solid var(--border);
        padding: 36px 20px 28px;
        margin-top: auto;
        overflow-x: clip;
      }

      .footer-inner {
        max-width: 1080px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        min-width: 0;
      }

      .footer-inner > div:first-child {
        min-width: 0;
        max-width: 100%;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 1.15rem;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 8px;
      }

      .footer-logo {
        width: 28px;
        height: 28px;
        display: block;
        flex-shrink: 0;
      }

      .footer-brand span {
        color: #7dd3fc;
      }

      .footer-copy {
        margin: 0;
        font-size: 0.84rem;
        color: #cbd5e1;
        max-width: 440px;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
        max-width: 100%;
      }

      .footer-links a {
        color: #ffffff;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
        transition: color 0.15s ease;
        overflow-wrap: anywhere;
      }

      .footer-links a:hover {
        color: #7dd3fc;
        text-decoration: underline;
      }

      .footer-bottom {
        max-width: 1080px;
        width: 100%;
        margin: 24px auto 0;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        overflow-wrap: anywhere;
      }

      @media (max-width: 860px) {
        .related-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .gallery-main-wrap {
          height: 340px;
        }

        .thumb-item {
          flex: 0 0 84px;
          width: 84px;
          height: 58px;
        }
      }

      @media (max-width: 640px) {
        .topbar {
          padding: 11px 12px;
        }

        .brand {
          font-size: 1.12rem;
          gap: 7px;
        }

        .brand-logo {
          width: 30px;
          height: 30px;
        }

        .topbar-badge {
          display: none;
        }

        .menu-toggle-btn {
          display: inline-flex;
        }

        .topbar-right {
          position: static;
          gap: 0;
        }

        .topbar-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          z-index: 50;
          background: #ffffff;
          border-bottom: 1px solid var(--border);
          box-shadow: 0 12px 24px rgba(12, 44, 87, 0.12);
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 6px 12px 10px;
        }

        .topbar-nav.is-open {
          display: flex;
        }

        .topbar-nav a {
          padding: 11px 12px;
          border-radius: 8px;
          font-size: 0.9rem;
        }

        .topbar-nav a:hover {
          background: #f0f9ff;
        }

        .hero {
          padding: 22px 12px 38px;
        }

        .container {
          padding: 0 12px 56px;
        }

        .section-box {
          padding: 16px;
          border-radius: 14px;
        }

        .gallery-box {
          padding: 10px;
        }

        .gallery-main-wrap {
          height: auto;
          aspect-ratio: 16 / 10;
          border-radius: 10px;
        }

        .slider-btn {
          width: 34px;
          height: 34px;
          font-size: 1.25rem;
        }

        .thumb-strip {
          gap: 6px;
          margin-top: 8px;
        }

        .thumb-item {
          flex: 0 0 74px;
          width: 74px;
          height: 52px;
          border-radius: 6px;
        }

        .map-locked-wrap {
          height: 230px;
        }

        .summary-bar {
          flex-direction: column;
          align-items: stretch;
        }

        .booking-panel {
          justify-content: space-between;
          padding-top: 12px;
          border-top: 1px solid var(--border);
        }

        .price-meta {
          text-align: left;
        }

        .price-amount {
          font-size: 1.18rem;
        }

        .btn-wa {
          padding: 10px 15px;
          font-size: 0.86rem;
        }

        .nearby-two-col,
        .related-grid {
          grid-template-columns: minmax(0, 1fr);
        }

        .site-footer {
          padding: 28px 12px 24px;
        }
      }
    </style>
  </head>
  <body>
    <header id="topbar" class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand" aria-label="villa.web.id Beranda">
          <svg
            class="brand-logo"
            viewBox="0 0 64 64"
            width="34"
            height="34"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="vw-badge-bg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0194f3" />
                <stop offset="100%" stop-color="#0c2c57" />
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#vw-badge-bg)" />
            <path
              d="M14 33 L32 16 L50 33"
              fill="none"
              stroke="#ff5e1f"
              stroke-width="5.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M21 31 V44 H43 V31"
              fill="none"
              stroke="#ffffff"
              stroke-width="4.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M16 51 Q24 47 32 51 T48 51"
              fill="none"
              stroke="#7dd3fc"
              stroke-width="3.8"
              stroke-linecap="round"
            />
          </svg>
          <span class="brand-text">villa<span>.web.id</span></span>
        </a>
        <div class="topbar-right">
          <nav id="topbar-nav" class="topbar-nav" aria-label="Navigasi utama">
            <a href="/">Semua Villa</a>
            <a href="/cara-pesan">Cara Pesan</a>
            <a href="/bantuan">Bantuan</a>
            <a href="/kontak">Kontak</a>
            <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
          </nav>
          <span class="topbar-badge">Sewa Villa Puncak, Cipanas &amp; Kota Bunga</span>
          <button
            type="button"
            id="menu-toggle-btn"
            class="menu-toggle-btn"
            aria-label="Buka menu navigasi"
            aria-expanded="false"
            aria-controls="topbar-nav"
          >
            &#9776;
          </button>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span>/</span>
          <span>{villa.location}</span>
          <span>/</span>
          <span>{villa.name}</span>
        </nav>

        <div class="hero-top">
          <div>
            <h1>{villa.name}</h1>
            <p class="hero-loc">{villa.location}</p>
          </div>
          <div class="hero-rating-chip">
            <span class="hero-rating-score">{Number(villa.rating || 0).toFixed(1)}</span>
            <span>
              <strong>{getRatingLabel(villa.rating)}</strong> &bull; {villa.jumlah_ulasan || 0} ulasan
            </span>
          </div>
        </div>
      </div>
    </section>

    <main class="container">
      <!-- Galeri: 1 Gambar Utama di Atas + Thumbnail di Bawah -->
      <section class="section-box gallery-box" aria-label="Galeri foto villa">
        <div id="gallery-main" class="gallery-main-wrap">
          <img
            id="hero-slide-img"
            src={mainPhoto}
            alt={villa.name}
            loading="eager"
            decoding="sync"
            onerror={`this.onerror=null;this.src='${fallbackImage}';`}
          />
          {
            galleryPhotos.length > 1 && (
              <>
                <button
                  type="button"
                  id="slide-prev-btn"
                  class="slider-btn prev"
                  aria-label="Foto sebelumnya"
                >
                  &#8249;
                </button>
                <button
                  type="button"
                  id="slide-next-btn"
                  class="slider-btn next"
                  aria-label="Foto berikutnya"
                >
                  &#8250;
                </button>
              </>
            )
          }
          <span id="photo-badge" class="photo-badge">1 / {galleryPhotos.length}</span>
        </div>

        <div id="thumb-strip" class="thumb-strip" aria-label="Thumbnail foto">
          {
            galleryPhotos.map((src, idx) => (
              <button
                type="button"
                class:list={["thumb-item", idx === 0 && "active"]}
                data-photo-index={idx}
                aria-label={`Lihat foto ${idx + 1} ${villa.name}`}
              >
                <img
                  src={src}
                  alt={`Thumbnail ${idx + 1} ${villa.name}`}
                  loading="eager"
                  decoding="sync"
                  onerror={`this.onerror=null;this.src='${fallbackImage}';`}
                />
              </button>
            ))
          }
        </div>
      </section>

      <!-- Ringkasan Spesifikasi, Harga & Tombol Booking -->
      <section class="section-box" aria-label="Ringkasan dan pemesanan">
        <div class="summary-bar">
          <div class="spec-chips">
            <span class="spec-chip">{villa.jumlah_kamar} Kamar Tidur</span>
            <span class="spec-chip">Maks. {villa.kapasitas_maks} Tamu</span>
            <span class="spec-chip">{villa.location}</span>
          </div>

          <div class="booking-panel">
            <div class="price-meta">
              <span class="price-label">Harga mulai / malam</span>
              <span class="price-amount">{priceFormatted}</span>
            </div>
            <a
              id="wa-booking-btn"
              class="btn-wa"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
            >
              Booking via WA
            </a>
          </div>
        </div>
      </section>

      <!-- Deskripsi Villa -->
      {
        descriptionText && (
          <section class="section-box" aria-label="Deskripsi villa">
            <h2 class="section-heading">Tentang {villa.name}</h2>
            <p class="desc-body">{descriptionText}</p>
          </section>
        )
      }

      <!-- Fasilitas Villa -->
      {
        facilities.length > 0 && (
          <section class="section-box" aria-label="Fasilitas villa">
            <h2 class="section-heading">Fasilitas Unggulan &amp; Perlengkapan</h2>
            <div class="facility-grid">
              {facilities.map((item) => <span class="facility-badge">{item}</span>)}
            </div>
          </section>
        )
      }

      <!-- Peta Lokasi (Non-Clickable) -->
      <section class="section-box" aria-label="Peta lokasi villa">
        <h2 class="section-heading">Lokasi Peta — {villa.name}</h2>
        <div class="map-locked-wrap">
          <iframe
            title={`Peta lokasi ${villa.name} ${villa.location}`}
            src={mapEmbedUrl}
            loading="lazy"
            tabindex="-1"
            aria-hidden="true"
          ></iframe>
          <div class="map-click-shield" aria-hidden="true"></div>
        </div>
        <div class="map-caption">
          Area: <strong>{villa.name}</strong> &bull; {villa.location}
        </div>
      </section>

      <!-- Wisata & Restoran Terdekat -->
      {
        (wisataList.length > 0 || restoList.length > 0) && (
          <section class="section-box" aria-label="Lokasi sekitar villa">
            <div class="nearby-two-col">
              {
                wisataList.length > 0 && (
                  <div class="nearby-card">
                    <h2 class="section-heading">Wisata Terdekat</h2>
                    <ul class="nearby-list">
                      {wisataList.map((w) => <li>{w}</li>)}
                    </ul>
                  </div>
                )
              }
              {
                restoList.length > 0 && (
                  <div class="nearby-card">
                    <h2 class="section-heading">Restoran &amp; Kuliner Terdekat</h2>
                    <ul class="nearby-list">
                      {restoList.map((r) => <li>{r}</li>)}
                    </ul>
                  </div>
                )
              }
            </div>
          </section>
        )
      }

      <!-- Villa Lainnya -->
      {
        relatedVillas.length > 0 && (
          <section class="section-box" aria-label="Rekomendasi villa lainnya">
            <h2 class="section-heading">Villa Lainnya di villa.web.id</h2>
            <div class="related-grid">
              {
                relatedVillas.map((rv) => {
                  const rvPhoto = resolveAllGalleryUrls(rv)[0] || fallbackImage;
                  return (
                    <a href={`/villa/${rv.slug}`} class="rel-card">
                      <img
                        src={rvPhoto}
                        alt={rv.name}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='${fallbackImage}';`}
                      />
                      <div class="rel-body">
                        <div class="rel-title">{rv.name}</div>
                        <div class="rel-loc">{rv.location}</div>
                        <div class="rel-loc">
                          {rv.jumlah_kamar} Kamar &bull; Maks. {rv.kapasitas_maks} Tamu
                        </div>
                        <div class="rel-price">{formatRupiah(rv.price_per_night)} / malam</div>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </section>
        )
      }
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">
            <svg
              class="footer-logo"
              viewBox="0 0 64 64"
              width="28"
              height="28"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="60" height="60" rx="16" fill="#0194f3" />
              <path
                d="M14 33 L32 16 L50 33"
                fill="none"
                stroke="#ff5e1f"
                stroke-width="5.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M21 31 V44 H43 V31"
                fill="none"
                stroke="#ffffff"
                stroke-width="4.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16 51 Q24 47 32 51 T48 51"
                fill="none"
                stroke="#e0f2fe"
                stroke-width="3.8"
                stroke-linecap="round"
              />
            </svg>
            <span>villa<span>.web.id</span></span>
          </div>
          <p class="footer-copy">
            Layanan sewa villa di kawasan Puncak, Cipanas, Cisarua, dan Kota Bunga dengan proses booking jelas dan transparan.
          </p>
        </div>
        <nav class="footer-links" aria-label="Tautan informasi">
          <a href="/cara-pesan">Cara Pesan</a>
          <a href="/bantuan">Bantuan</a>
          <a href="/kontak">Kontak</a>
          <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>villa.web.id</span>
        <span>Puncak &bull; Cipanas &bull; Cisarua &bull; Kota Bunga</span>
      </div>
    </footer>

    <script
      is:inline
      define:vars={{
        villaName: villa.name,
        villaLocation: villa.location,
        priceFormatted,
        fallbackImage,
        galleryPhotos,
      }}
    >
      function initVillaDetailPage() {
        const WA_NUMBER = "6281234567890";

        const menuToggleBtn = document.getElementById("menu-toggle-btn");
        const topbarNav = document.getElementById("topbar-nav");
        const topbarEl = document.getElementById("topbar");

        function setMobileMenuOpen(isOpen) {
          if (!topbarNav || !menuToggleBtn) return;
          topbarNav.classList.toggle("is-open", isOpen);
          menuToggleBtn.setAttribute("aria-expanded", String(isOpen));
          menuToggleBtn.innerHTML = isOpen ? "&times;" : "&#9776;";
          menuToggleBtn.setAttribute(
            "aria-label",
            isOpen ? "Tutup menu navigasi" : "Buka menu navigasi"
          );
        }

        menuToggleBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = topbarNav?.classList.contains("is-open") || false;
          setMobileMenuOpen(!isOpen);
        });

        topbarNav?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMobileMenuOpen(false));
        });

        document.addEventListener("click", (e) => {
          if (!topbarNav?.classList.contains("is-open")) return;
          const target = e.target;
          if (target instanceof Node && !topbarNav.contains(target) && target !== menuToggleBtn) {
            setMobileMenuOpen(false);
          }
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setMobileMenuOpen(false);
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 640) setMobileMenuOpen(false);
        });

        function handleStickyHeader() {
          if (!topbarEl) return;
          topbarEl.classList.toggle("is-stuck", window.scrollY > 4);
        }

        window.addEventListener("scroll", handleStickyHeader, { passive: true });
        handleStickyHeader();

        const photos =
          Array.isArray(galleryPhotos) && galleryPhotos.length > 0
            ? galleryPhotos
            : [fallbackImage];

        photos.forEach((src) => {
          if (!src) return;
          const pre = new Image();
          pre.decoding = "sync";
          pre.src = src;
        });

        const galleryMain = document.getElementById("gallery-main");
        const heroImg = document.getElementById("hero-slide-img");
        const prevBtn = document.getElementById("slide-prev-btn");
        const nextBtn = document.getElementById("slide-next-btn");
        const badgeEl = document.getElementById("photo-badge");
        const stripEl = document.getElementById("thumb-strip");
        const thumbBtns = Array.from(document.querySelectorAll(".thumb-item"));
        const waBtn = document.getElementById("wa-booking-btn");

        let currentIdx = 0;

        function goToSlide(index, scrollThumbIntoView = false) {
          const total = photos.length;
          currentIdx = ((index % total) + total) % total;
          const nextSrc = photos[currentIdx] || fallbackImage;

          if (heroImg instanceof HTMLImageElement) {
            heroImg.style.transition = "none";
            heroImg.style.transform = "";
            heroImg.style.opacity = "1";
            heroImg.onerror = () => {
              heroImg.onerror = null;
              heroImg.src = fallbackImage;
            };
            heroImg.src = nextSrc;
            if (typeof heroImg.decode === "function") {
              heroImg.decode().catch(() => {});
            }
          }

          if (badgeEl) {
            badgeEl.textContent = `${currentIdx + 1} / ${total}`;
          }

          thumbBtns.forEach((btn, i) => {
            const isActive = i === currentIdx;
            btn.classList.toggle("active", isActive);
            if (isActive && scrollThumbIntoView && stripEl instanceof HTMLElement) {
              const targetScroll =
                btn.offsetLeft - stripEl.offsetLeft - (stripEl.clientWidth - btn.offsetWidth) / 2;
              stripEl.scrollTo({
                left: Math.max(0, targetScroll),
                behavior: "auto",
              });
            }
          });
        }

        prevBtn?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          goToSlide(currentIdx - 1, true);
        });

        nextBtn?.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          goToSlide(currentIdx + 1, true);
        });

        thumbBtns.forEach((btn, i) => {
          btn.addEventListener("pointerdown", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const rawIdx = Number(btn.getAttribute("data-photo-index"));
            goToSlide(Number.isNaN(rawIdx) ? i : rawIdx, true);
          });
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const rawIdx = Number(btn.getAttribute("data-photo-index"));
            goToSlide(Number.isNaN(rawIdx) ? i : rawIdx, true);
          });
        });

        let activePointerId = null;
        let startX = 0;
        let startY = 0;
        let isHorizontalSwipe = false;

        galleryMain?.addEventListener("pointerdown", (e) => {
          if (photos.length <= 1) return;
          if (e.pointerType === "mouse" && e.button !== 0) return;
          if (e.target instanceof Element && e.target.closest(".slider-btn")) return;

          activePointerId = e.pointerId;
          startX = e.clientX;
          startY = e.clientY;
          isHorizontalSwipe = false;
          galleryMain.classList.add("is-dragging");

          try {
            galleryMain.setPointerCapture(e.pointerId);
          } catch {
            // Abaikan jika tidak didukung
          }
        });

        galleryMain?.addEventListener("pointermove", (e) => {
          if (activePointerId === null || e.pointerId !== activePointerId) return;

          const dx = e.clientX - startX;
          const dy = e.clientY - startY;

          if (!isHorizontalSwipe && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
            isHorizontalSwipe = true;
          }

          if (isHorizontalSwipe && heroImg instanceof HTMLImageElement) {
            if (e.cancelable) e.preventDefault();
            const clamped = Math.max(-52, Math.min(52, dx * 0.35));
            heroImg.style.transition = "none";
            heroImg.style.transform = `translateX(${clamped}px)`;
          }
        });

        function finishMainPointer(e) {
          if (activePointerId === null || e.pointerId !== activePointerId) return;

          const dx = e.clientX - startX;
          const dy = e.clientY - startY;

          if (heroImg instanceof HTMLImageElement) {
            heroImg.style.transition = "none";
            heroImg.style.transform = "";
          }

          if (isHorizontalSwipe && Math.abs(dx) > 22 && Math.abs(dx) >= Math.abs(dy) * 0.85) {
            if (dx < 0) {
              goToSlide(currentIdx + 1, true);
            } else {
              goToSlide(currentIdx - 1, true);
            }
          }

          activePointerId = null;
          isHorizontalSwipe = false;
          galleryMain?.classList.remove("is-dragging");
        }

        galleryMain?.addEventListener("pointerup", finishMainPointer);
        galleryMain?.addEventListener("pointercancel", finishMainPointer);

        document.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") goToSlide(currentIdx - 1, true);
          if (e.key === "ArrowRight") goToSlide(currentIdx + 1, true);
        });

        if (waBtn instanceof HTMLAnchorElement) {
          const waText = encodeURIComponent(
            `Halo villa.web.id, saya ingin tanya ketersediaan & booking ${villaName} (${villaLocation}) dengan harga mulai ${priceFormatted}/malam.`
          );
          waBtn.href = `https://wa.me/${WA_NUMBER}?text=${waText}`;
        }
      }

      initVillaDetailPage();
      document.addEventListener("astro:after-swap", initVillaDetailPage);
    </script>
  </body>
</html>