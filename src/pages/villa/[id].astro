        --sky: #0194f3;
        --blue: #0770cd;
        --navy: #0c2c57;
        --orange: #ff5e1f;
        --green: #16a34a;
        --green-dark: #15803d;
        --bg: #f1f5f9;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --shadow-sm: 0 4px 14px rgba(12, 44, 87, 0.05);
        --shadow-md: 0 12px 28px rgba(12, 44, 87, 0.09);
      }

