---
// --- BAGIAN 1: FRONTMATTER ---
import { Image } from 'astro:assets';
import { db } from '../lib/db'; // Import client Turso Anda

// Ambil data villa dari Turso
const result = await db.execute("SELECT * FROM villas");
const villasData = result.rows;

// Ambil semua aset gambar lokal secara eager (langsung tersedia)
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/villas/**/*.{jpeg,jpg,png,webp}', { eager: true });

function getLocalAsset(cloudinaryUrl) {
  if (!cloudinaryUrl) return null;
  try {
    // Memisahkan URL Cloudinary untuk mendapatkan nama file
    const parts = cloudinaryUrl.split(/\/v\d+\//);
    if (parts.length < 2) return null;
    
    const fileName = decodeURIComponent(parts[1]);
    // Pastikan path sesuai dengan struktur di folder /src/assets/villas/
    const localPath = `/src/assets/villas/${fileName}`;
    
    const asset = localImages[localPath];
    return asset ? asset.default : null;
  } catch (e) {
    return null;
  }
}
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  {villasData.map((villa) => {
    const imageAsset = getLocalAsset(villa.main_photo_url);
    return (
      <div class="villa-card border border-slate-100 p-4 rounded-2xl">
        {imageAsset ? (
          <Image 
            src={imageAsset} 
            alt={villa.name}
            width={600}
            height={400}
            format="webp"
            quality="mid"
            class="rounded-xl w-full h-64 object-cover"
          />
        ) : (
          <div class="bg-gray-100 h-64 flex items-center justify-center rounded-xl">
             <span class="text-xs text-gray-400">Foto {villa.name} tidak tersedia</span>
          </div>
        )}
        <h3 class="font-bold mt-4 text-slate-900">{villa.name}</h3>
        <p class="text-sm text-slate-500 italic">📍 {villa.location}</p>
        <p class="text-blue-600 font-bold mt-2">
          Rp {new Intl.NumberFormat('id-ID').format(villa.price_per_night)}
        </p>
      </div>
    );
  })}
</div>